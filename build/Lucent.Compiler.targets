<Project>
  <UsingTask
    TaskName="Lucent.Compiler.MSBuild.CompileLucent"
    AssemblyFile="$(LucentCompilerTaskAssembly)" />
  <UsingTask
    TaskName="Lucent.Compiler.MSBuild.VerifyLucentModuleManifest"
    AssemblyFile="$(LucentCompilerTaskAssembly)" />

  <ItemGroup Condition="'@(LucentSource)' != '' and Exists('$(LucentRuntimeProject)')">
    <ProjectReference Include="$(LucentRuntimeProject)" />
  </ItemGroup>

  <Target Name="CollectLucentGenerationInputs" Condition="'@(LucentSource)' != '' or '@(LucentStyle)' != ''">
    <ItemGroup>
      <_LucentAdjacentStyleCandidate Include="@(LucentSource->'%(RootDir)%(Directory)%(Filename).css')" />
      <_LucentAdjacentStyle Include="@(_LucentAdjacentStyleCandidate)"
                            Condition="Exists('%(_LucentAdjacentStyleCandidate.Identity)')" />
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <_LucentCompilerManifestFullPath Condition="$([System.IO.Path]::IsPathFullyQualified('$(LucentCompilerManifestPath)'))">$(LucentCompilerManifestPath)</_LucentCompilerManifestFullPath>
    <_LucentCompilerManifestFullPath Condition="'$(_LucentCompilerManifestFullPath)' == ''">$(MSBuildProjectDirectory)\$(LucentCompilerManifestPath)</_LucentCompilerManifestFullPath>
    <_LucentModuleManifestFullPath Condition="$([System.IO.Path]::IsPathFullyQualified('$(LucentModuleManifestPath)'))">$(LucentModuleManifestPath)</_LucentModuleManifestFullPath>
    <_LucentModuleManifestFullPath Condition="'$(_LucentModuleManifestFullPath)' == ''">$(MSBuildProjectDirectory)\$(LucentModuleManifestPath)</_LucentModuleManifestFullPath>
    <_LucentModuleManifestLastSuccessfulFullPath Condition="$([System.IO.Path]::IsPathFullyQualified('$(LucentModuleManifestLastSuccessfulPath)'))">$(LucentModuleManifestLastSuccessfulPath)</_LucentModuleManifestLastSuccessfulFullPath>
    <_LucentModuleManifestLastSuccessfulFullPath Condition="'$(_LucentModuleManifestLastSuccessfulFullPath)' == ''">$(MSBuildProjectDirectory)\$(LucentModuleManifestLastSuccessfulPath)</_LucentModuleManifestLastSuccessfulFullPath>
    <_LucentGenerationInputsFullPath Condition="$([System.IO.Path]::IsPathFullyQualified('$(LucentGenerationInputsPath)'))">$(LucentGenerationInputsPath)</_LucentGenerationInputsFullPath>
    <_LucentGenerationInputsFullPath Condition="'$(_LucentGenerationInputsFullPath)' == ''">$(MSBuildProjectDirectory)\$(LucentGenerationInputsPath)</_LucentGenerationInputsFullPath>
  </PropertyGroup>

  <!-- The atomic generated-item manifest restores required Compile items and
       tracked prior inputs when GenerateLucent is skipped as up-to-date. -->
  <Import Project="$(_LucentCompilerManifestFullPath)"
          Condition="Exists('$(_LucentCompilerManifestFullPath)')" />

  <Target Name="WriteLucentGenerationInputs" Condition="'$(LucentCompilerEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <MakeDir Directories="$(LucentCompilerOutputDirectory)" />
    <PropertyGroup>
      <_LucentGenerationIdentity>AssemblyName=$(AssemblyName)|AssemblyVersion=$(AssemblyVersion)|AssemblyCulture=$(AssemblyCulture)|SignAssembly=$(SignAssembly)|AssemblyOriginatorKeyFile=$(AssemblyOriginatorKeyFile)|PublicSign=$(PublicSign)|DelaySign=$(DelaySign)|TargetFramework=$(TargetFramework)|LangVersion=$(LangVersion)|Nullable=$(Nullable)|DefineConstants=$(DefineConstants)|GlobalUsings=@(Using, '|')|LucentStyles=@(LucentStyle, '|')|ProjectReferences=@(ProjectReference, '|')</_LucentGenerationIdentity>
    </PropertyGroup>
    <WriteLinesToFile File="$(_LucentGenerationInputsFullPath)"
                      Lines="$(_LucentGenerationIdentity)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <FileWrites Include="$(_LucentGenerationInputsFullPath)" />
      <_LucentSigningKey Include="$(AssemblyOriginatorKeyFile)"
                         Condition="'$(SignAssembly)' == 'true' and Exists('$(AssemblyOriginatorKeyFile)')" />
    </ItemGroup>
  </Target>

  <Target
    Name="GenerateLucent"
    BeforeTargets="PrepareResources;CreateManifestResourceNames;CoreCompile"
    DependsOnTargets="CollectLucentGenerationInputs;ResolveReferences;GenerateGlobalUsings;GenerateAssemblyInfo;WriteLucentGenerationInputs"
    Inputs="$(MSBuildProjectFullPath);$(_LucentGenerationInputsFullPath);@(LucentSource);@(LucentStyle);@(_LucentTrackedSource);@(_LucentAdjacentStyle);@(_LucentTrackedStyle);@(_LucentSigningKey);@(Compile);@(ReferencePathWithRefAssemblies);@(ReferencePath)"
    Outputs="$(_LucentCompilerManifestFullPath);$(_LucentModuleManifestFullPath)"
    Condition="'$(LucentCompilerEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <MakeDir Directories="$(LucentCompilerOutputDirectory)" />

    <ItemGroup>
      <!-- Task outputs append to item lists when this target is invoked again in one node. -->
      <_LucentModuleManifestFiles Remove="@(_LucentModuleManifestFiles)" />
      <_LucentGeneratedCompile Remove="@(_LucentGeneratedCompile)" />
      <Compile Remove="%(Compile.Identity)" Condition="'%(Compile.LucentGenerated)' == 'true'" />
    </ItemGroup>

    <CompileLucent
      Sources="@(LucentSource)"
      Styles="@(LucentStyle)"
      OutputDirectory="$(LucentCompilerOutputDirectory)"
      ManifestPath="$(LucentCompilerManifestPath)"
      ModuleManifestPath="$(_LucentModuleManifestFullPath)"
      AssemblyName="$(AssemblyName)"
      AssemblyVersion="$(AssemblyVersion)"
      AssemblyCulture="$(AssemblyCulture)"
      SignAssembly="$(SignAssembly)"
      AssemblyOriginatorKeyFile="$(AssemblyOriginatorKeyFile)"
      PublicSign="$(PublicSign)"
      DelaySign="$(DelaySign)"
      RootNamespace="$(RootNamespace)"
      OutputType="$(OutputType)"
      StyleCatalogTypes="@(LucentStyleCatalog)"
      References="@(ReferencePathWithRefAssemblies);@(ReferencePath)"
      CSharpSources="@(Compile);$(MSBuildProjectDirectory)\$(GeneratedAssemblyInfoFile);$(MSBuildProjectDirectory)\$(TargetFrameworkMonikerAssemblyAttributesPath)"
      ProjectPath="$(MSBuildProjectFullPath)"
      TargetFramework="$(TargetFramework)"
      LanguageVersion="$(LangVersion)"
      Nullable="$(Nullable)"
      DefineConstants="$(DefineConstants)"
      GlobalUsings="@(Using)"
      ProjectReferences="@(ProjectReference)">
      <Output TaskParameter="GeneratedFiles" ItemName="_LucentGeneratedFiles" />
      <Output TaskParameter="ModuleManifestFiles" ItemName="_LucentModuleManifestFiles" />
    </CompileLucent>

    <ItemGroup>
      <_LucentGeneratedCompile Include="@(_LucentGeneratedFiles)" />
      <FileWrites Include="@(_LucentGeneratedFiles)" />
      <FileWrites Include="$(LucentCompilerManifestPath)" />
      <FileWrites Include="@(_LucentModuleManifestFiles)" />
    </ItemGroup>
  </Target>

  <Target Name="IncludeLucentGeneratedCompile"
          BeforeTargets="CoreCompile"
          DependsOnTargets="GenerateLucent"
          Condition="'$(LucentCompilerEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <Compile Include="@(_LucentGeneratedCompile)" AutoGen="true" LucentGenerated="true" />
    </ItemGroup>
  </Target>

  <Target Name="IncludeLucentModuleManifest"
          BeforeTargets="PrepareResources;CreateManifestResourceNames;CoreCompile"
          DependsOnTargets="GenerateLucent"
          Condition="'$(LucentCompilerEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true' and ('@(LucentSource)' != '' or '@(LucentStyle)' != '') and Exists('$(_LucentModuleManifestFullPath)')">
    <ItemGroup>
      <!-- A consumer-owned resource is never silently replaced by Lucent. -->
      <_LucentModuleManifestCollisions Include="@(EmbeddedResource)"
          Condition="'%(EmbeddedResource.LogicalName)' == 'Lucent.ModuleManifest.v1.json' and '%(EmbeddedResource.LucentGenerated)' != 'true'" />
    </ItemGroup>
    <Error Condition="'@(_LucentModuleManifestCollisions)' != ''"
           Text="Lucent cannot embed its module manifest because EmbeddedResource '%(_LucentModuleManifestCollisions.Identity)' already claims logical name 'Lucent.ModuleManifest.v1.json'." />
    <ItemGroup>
      <EmbeddedResource Remove="$(_LucentModuleManifestFullPath)" />
      <EmbeddedResource Include="$(_LucentModuleManifestFullPath)" LogicalName="Lucent.ModuleManifest.v1.json" Type="Non-Resx" WithCulture="false" LucentGenerated="true" />
    </ItemGroup>
  </Target>

  <Target Name="PromoteLucentModuleManifest"
          BeforeTargets="_TimeStampAfterCompile"
          Inputs="$(IntermediateOutputPath)$(TargetFileName);$(_LucentModuleManifestFullPath)"
          Outputs="$(_LucentModuleManifestLastSuccessfulFullPath)"
          Condition="'$(LucentCompilerEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <VerifyLucentModuleManifest AssemblyPath="$(IntermediateOutputPath)$(TargetFileName)"
                                ManifestPath="$(_LucentModuleManifestFullPath)"
                                LastSuccessfulPath="$(_LucentModuleManifestLastSuccessfulFullPath)"
                                Condition="Exists('$(IntermediateOutputPath)$(TargetFileName)') and Exists('$(_LucentModuleManifestFullPath)')" />
    <ItemGroup>
      <FileWrites Include="$(_LucentModuleManifestLastSuccessfulFullPath)" />
    </ItemGroup>
  </Target>

  <!-- Reached only after CoreCompile's successful timestamp path. -->
  <Target Name="RemoveLucentModuleManifestWithoutSources"
          BeforeTargets="_TimeStampAfterCompile"
          Condition="'$(LucentCompilerEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true' and '@(LucentSource)' == '' and '@(LucentStyle)' == ''">
    <Delete Files="$(_LucentCompilerManifestFullPath);$(_LucentModuleManifestFullPath);$(_LucentModuleManifestLastSuccessfulFullPath)" />
  </Target>

  <Target Name="CleanLucentModuleManifest" AfterTargets="CoreClean">
    <Delete Files="$(_LucentCompilerManifestFullPath);$(_LucentModuleManifestFullPath);$(_LucentModuleManifestLastSuccessfulFullPath);$(_LucentGenerationInputsFullPath)" />
  </Target>
</Project>
