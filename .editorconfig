root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{cs,lui}]
indent_style = space
indent_size = 4

[*.g.cs]
generated_code = true
end_of_line = lf

[*.{css,json,jsonc,yml,yaml}]
indent_style = space
indent_size = 2
