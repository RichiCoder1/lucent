<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <Import Project="..\..\build\Lucent.Compiler.props" />

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference
      Include="..\Lucent.Compiler.MSBuild\Lucent.Compiler.MSBuild.csproj"
      ReferenceOutputAssembly="false"
      PrivateAssets="all" />
    <LucentSource Include="..\..\examples\counter\Counter.lui" />
    <LucentSource Include="..\..\examples\todo\Todo.lui" />
    <Compile Include="..\..\examples\todo\TodoModel.cs" Link="TodoModel.cs" />
    <Compile Remove="Generated\CounterComponent.g.cs" />
  </ItemGroup>

  <Import Project="..\..\build\Lucent.Compiler.targets" />
</Project>
