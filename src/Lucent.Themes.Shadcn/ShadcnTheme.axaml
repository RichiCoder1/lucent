<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Lucent.Themes.Shadcn.ShadcnTheme">
  <!-- Shadcn New York/neutral snapshot; source mappings are documented in docs/SHADCN_THEME.md. -->
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Shadcn.Background" Color="#FFFFFF"/><SolidColorBrush x:Key="Shadcn.Foreground" Color="#171717"/>
          <SolidColorBrush x:Key="Shadcn.Card" Color="#FFFFFF"/><SolidColorBrush x:Key="Shadcn.CardForeground" Color="#171717"/>
          <SolidColorBrush x:Key="Shadcn.Popover" Color="#FFFFFF"/><SolidColorBrush x:Key="Shadcn.PopoverForeground" Color="#171717"/>
          <SolidColorBrush x:Key="Shadcn.Primary" Color="#343434"/><SolidColorBrush x:Key="Shadcn.PrimaryForeground" Color="#FAFAFA"/>
          <SolidColorBrush x:Key="Shadcn.Secondary" Color="#F5F5F5"/><SolidColorBrush x:Key="Shadcn.SecondaryForeground" Color="#171717"/>
          <SolidColorBrush x:Key="Shadcn.Muted" Color="#F5F5F5"/><SolidColorBrush x:Key="Shadcn.MutedForeground" Color="#666666"/>
          <SolidColorBrush x:Key="Shadcn.Accent" Color="#F5F5F5"/><SolidColorBrush x:Key="Shadcn.AccentForeground" Color="#171717"/>
          <SolidColorBrush x:Key="Shadcn.Destructive" Color="#E7000B"/><SolidColorBrush x:Key="Shadcn.DestructiveForeground" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="Shadcn.Border" Color="#E5E5E5"/><SolidColorBrush x:Key="Shadcn.Input" Color="#E5E5E5"/><SolidColorBrush x:Key="Shadcn.Ring" Color="#ABABAB"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Shadcn.Background" Color="#171717"/><SolidColorBrush x:Key="Shadcn.Foreground" Color="#FAFAFA"/>
          <SolidColorBrush x:Key="Shadcn.Card" Color="#262626"/><SolidColorBrush x:Key="Shadcn.CardForeground" Color="#FAFAFA"/>
          <SolidColorBrush x:Key="Shadcn.Popover" Color="#262626"/><SolidColorBrush x:Key="Shadcn.PopoverForeground" Color="#FAFAFA"/>
          <SolidColorBrush x:Key="Shadcn.Primary" Color="#E5E5E5"/><SolidColorBrush x:Key="Shadcn.PrimaryForeground" Color="#262626"/>
          <SolidColorBrush x:Key="Shadcn.Secondary" Color="#404040"/><SolidColorBrush x:Key="Shadcn.SecondaryForeground" Color="#FAFAFA"/>
          <SolidColorBrush x:Key="Shadcn.Muted" Color="#404040"/><SolidColorBrush x:Key="Shadcn.MutedForeground" Color="#ABABAB"/>
          <SolidColorBrush x:Key="Shadcn.Accent" Color="#404040"/><SolidColorBrush x:Key="Shadcn.AccentForeground" Color="#FAFAFA"/>
          <SolidColorBrush x:Key="Shadcn.Destructive" Color="#FF6467"/><SolidColorBrush x:Key="Shadcn.DestructiveForeground" Color="#171717"/>
          <SolidColorBrush x:Key="Shadcn.Border" Color="#1AFFFFFF"/><SolidColorBrush x:Key="Shadcn.Input" Color="#1AFFFFFF"/><SolidColorBrush x:Key="Shadcn.Ring" Color="#737373"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
  <Style Selector="Button"><Setter Property="Background" Value="{DynamicResource Shadcn.Primary}"/><Setter Property="Foreground" Value="{DynamicResource Shadcn.PrimaryForeground}"/><Setter Property="MinHeight" Value="36"/><Setter Property="CornerRadius" Value="4"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style Selector="Button:pointerover"><Setter Property="Background" Value="{DynamicResource Shadcn.Accent}"/><Setter Property="Foreground" Value="{DynamicResource Shadcn.AccentForeground}"/></Style>
  <Style Selector="Button:pressed"><Setter Property="Background" Value="{DynamicResource Shadcn.Muted}"/></Style>
  <Style Selector="Button:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource Shadcn.Ring}"/><Setter Property="BorderThickness" Value="2"/></Style>
  <Style Selector="Button:disabled"><Setter Property="Background" Value="{DynamicResource Shadcn.Muted}"/><Setter Property="Foreground" Value="{DynamicResource Shadcn.MutedForeground}"/></Style>
  <Style Selector="Button.secondary"><Setter Property="Background" Value="{DynamicResource Shadcn.Secondary}"/><Setter Property="Foreground" Value="{DynamicResource Shadcn.SecondaryForeground}"/></Style>
  <Style Selector="Button.destructive"><Setter Property="Background" Value="{DynamicResource Shadcn.Destructive}"/><Setter Property="Foreground" Value="{DynamicResource Shadcn.DestructiveForeground}"/></Style>
  <Style Selector="Button.outline"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Shadcn.Foreground}"/><Setter Property="BorderBrush" Value="{DynamicResource Shadcn.Border}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style Selector="Button.ghost"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Shadcn.Foreground}"/></Style>
  <Style Selector="Button.link"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Shadcn.Foreground}"/></Style>
  <Style Selector="TextBox"><Setter Property="MinHeight" Value="36"/><Setter Property="BorderBrush" Value="{DynamicResource Shadcn.Input}"/><Setter Property="CornerRadius" Value="4"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style Selector="TextBox:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource Shadcn.Ring}"/><Setter Property="BorderThickness" Value="2"/></Style>
  <Style Selector="TextBox:invalid"><Setter Property="BorderBrush" Value="{DynamicResource Shadcn.Destructive}"/><Setter Property="BorderThickness" Value="2"/></Style>
  <!-- Accessibility override (not upstream): disabled foreground retains AA contrast on muted surfaces. -->
  <Style Selector="TextBox:disabled, CheckBox:disabled, RadioButton:disabled, ComboBox:disabled"><Setter Property="Foreground" Value="{DynamicResource Shadcn.MutedForeground}"/></Style>
  <Style Selector="CheckBox, RadioButton"><Setter Property="Foreground" Value="{DynamicResource Shadcn.Foreground}"/></Style>
  <Style Selector="CheckBox:pointerover, RadioButton:pointerover"><Setter Property="Foreground" Value="{DynamicResource Shadcn.AccentForeground}"/></Style>
  <Style Selector="CheckBox:checked, RadioButton:checked"><Setter Property="Foreground" Value="{DynamicResource Shadcn.Primary}"/></Style>
  <Style Selector="CheckBox:unchecked, RadioButton:unchecked"><Setter Property="Foreground" Value="{DynamicResource Shadcn.Foreground}"/></Style>
  <Style Selector="ComboBox, ListBox, Menu, TabControl"><Setter Property="Foreground" Value="{DynamicResource Shadcn.Foreground}"/></Style>
  <Style Selector="CheckBox:focus-visible, RadioButton:focus-visible, ComboBox:focus-visible, ListBox:focus-visible, Menu:focus-visible, TabControl:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource Shadcn.Ring}"/><Setter Property="BorderThickness" Value="2"/></Style>
  <Style Selector="ComboBox:pointerover"><Setter Property="BorderBrush" Value="{DynamicResource Shadcn.Accent}"/></Style>
  <Style Selector="ListBoxItem:pointerover, TabItem:pointerover, MenuItem:pointerover"><Setter Property="Background" Value="{DynamicResource Shadcn.Accent}"/><Setter Property="Foreground" Value="{DynamicResource Shadcn.AccentForeground}"/></Style>
  <Style Selector="ListBoxItem:selected, TabItem:selected, MenuItem:selected"><Setter Property="Background" Value="{DynamicResource Shadcn.Accent}"/><Setter Property="Foreground" Value="{DynamicResource Shadcn.AccentForeground}"/></Style>
  <Style Selector="ListBoxItem:unselected, TabItem:unselected, MenuItem:unselected"><Setter Property="Foreground" Value="{DynamicResource Shadcn.Foreground}"/></Style>
  <Style Selector="MenuItem:pointerover"><Setter Property="Background" Value="{DynamicResource Shadcn.Accent}"/><Setter Property="Foreground" Value="{DynamicResource Shadcn.AccentForeground}"/></Style>
  <Style Selector="ToolTip"><Setter Property="Background" Value="{DynamicResource Shadcn.Popover}"/><Setter Property="Foreground" Value="{DynamicResource Shadcn.PopoverForeground}"/><Setter Property="BorderBrush" Value="{DynamicResource Shadcn.Border}"/></Style>
  <Style Selector="ScrollBar"><Setter Property="Background" Value="{DynamicResource Shadcn.Muted}"/></Style>
  <Style Selector="Border.card"><Setter Property="Background" Value="{DynamicResource Shadcn.Card}"/><Setter Property="BorderBrush" Value="{DynamicResource Shadcn.Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="16"/></Style>
</Styles>
