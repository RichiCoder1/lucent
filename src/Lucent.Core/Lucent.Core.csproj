<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <LucentLuiLangVersion>preview</LucentLuiLangVersion>
    <LucentLuiProjectIdentity>$(MSBuildProjectFullPath)</LucentLuiProjectIdentity>
    <LucentLuiProjectEpoch>$(MSBuildProjectFullPath)|$(TargetFramework)|$(Configuration)|$(MSBuildProjectExtensionsPath)|$(LangVersion)|$(Nullable)|$(DefineConstants)|@(ReferencePath)|@(Using)</LucentLuiProjectEpoch>
    <LucentLuiCompilerOptions>$(LangVersion)|$(Nullable)|$(DefineConstants)|@(ReferencePath)|@(Using)</LucentLuiCompilerOptions>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Lucent.Lui.Compiler/Lucent.Lui.Compiler.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" GlobalPropertiesToRemove="PublishAot;PublishTrimmed;RuntimeIdentifier;SelfContained" />
    <ProjectReference Include="../Lucent.Lui.Generator/Lucent.Lui.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" GlobalPropertiesToRemove="PublishAot;PublishTrimmed;RuntimeIdentifier;SelfContained" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="Components/**/*.lui" LucentLuiLogicalPath="Components/%(RecursiveDir)%(Filename)%(Extension)" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="LucentLuiLogicalPath" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="LucentLuiDocumentVersion" />
    <CompilerVisibleProperty Include="LucentLuiProjectIdentity" />
    <CompilerVisibleProperty Include="LucentLuiProjectEpoch" />
    <CompilerVisibleProperty Include="LucentLuiCompilerOptions" />
    <CompilerVisibleProperty Include="LucentLuiLangVersion" />
    <CompilerVisibleProperty Include="LucentLuiDefines" />
    <CompilerVisibleProperty Include="RootNamespace" />
  </ItemGroup>
  <Target Name="PrepareLucentLuiProjectContext" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <LucentLuiProjectEpoch>$(MSBuildProjectFullPath)|$(TargetFramework)|$(Configuration)|$(LangVersion)|$(Nullable)|$(DefineConstants)|@(ReferencePath)|@(Using)</LucentLuiProjectEpoch>
      <LucentLuiCompilerOptions>$(LangVersion)|$(Nullable)|$(DefineConstants)|@(ReferencePath)|@(Using)</LucentLuiCompilerOptions>
      <LucentLuiDefines>$(DefineConstants)</LucentLuiDefines>
    </PropertyGroup>
  </Target>
</Project>
