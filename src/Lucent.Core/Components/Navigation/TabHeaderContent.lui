namespace Lucent.Core;

style TabHeaderLabelStyle {
    TextWrap: TextWrap.NoWrap;
    Overflow: TextOverflow.Ellipsis;
}

internal component TabHeaderContent(TabHeaderBinding binding) {
    <TabHeaderHost binding={binding}>
        <SelectionDecoration content={binding.Label} style={TabHeaderLabelStyle} />
        <TabSelectionUnderline selected={binding.Selected} />
    </TabHeaderHost>
}
