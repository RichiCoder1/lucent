namespace Lucent.Core;

style RadioGroupLabelStyle {
    MinHeight: 20;
    TextWrap: TextWrap.WordWithGraphemeFallback;
}

internal component RadioGroupContent(
    RadioGroupBinding binding,
    [DefaultContent] ComponentContent options,
    Style? style
) {
    <RadioGroupHost binding={binding} style={style}>
        <SelectionDecoration content={() => binding.Label} style={RadioGroupLabelStyle} />
        {options}
    </RadioGroupHost>
}
