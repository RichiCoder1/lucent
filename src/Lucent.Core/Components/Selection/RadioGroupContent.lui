namespace Lucent.Core;

style RadioGroupLabelStyle {
    MinHeight: 20;
    TextWrap: TextWrap.WordWithGraphemeFallback;
}

style RadioGroupOptionsStyle {
    Axis: LayoutAxis.Column;
    Spacing: 2;
}

internal component RadioGroupContent(RadioGroupBinding binding, [DefaultContent] ComponentContent options, Style? style) {
    <RadioGroupHost binding={binding} style={style}>
        <SelectionDecoration content={() => binding.Label} style={RadioGroupLabelStyle} />
        <Layout style={RadioGroupOptionsStyle}>
            {options}
        </Layout>
    </RadioGroupHost>
}
