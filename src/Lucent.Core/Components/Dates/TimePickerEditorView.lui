namespace Lucent.Core;
using System;

internal component TimePickerEditorView(
    FieldContext field,
    TimeEditSession session,
    Func<bool>? enabled,
    Func<bool>? readOnly,
    Action decrease,
    Action increase,
    Style actionStyle
) {
    <TimePickerHost session={session} label={field.AccessibleName} enabled={enabled} readOnly={readOnly}>
        <DateTimeTextField field={field} session={session} enabled={enabled} readOnly={readOnly} />
        <IconButton source={DateTimeArtwork.Decrease} label={"Decrease " + field.AccessibleName} onInvoke={decrease} style={actionStyle} />
        <IconButton source={DateTimeArtwork.Increase} label={"Increase " + field.AccessibleName} onInvoke={increase} style={actionStyle} />
    </TimePickerHost>
}
