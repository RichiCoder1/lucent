namespace Lucent.Core;
using System;

/// <summary>Creates a controlled confidential editor with deliberate reveal and bounded history.</summary>
public component PasswordField(
    string label,
    Func<string> value,
    Action<string> onChangeRequested,
    PasswordFieldOptions? options = null,
    Func<ValidationState>? validation = null,
    Func<string>? help = null,
    FormSession? form = null,
    string? fieldId = null,
    FieldParticipation participation = FieldParticipation.WhenNotCollapsed,
    bool required = false,
    Func<bool>? enabled = null,
    Func<bool>? readOnly = null,
    Style? style = null
) {
    <Field
        label={label}
        editor={field => PasswordFieldEditor(field, value, onChangeRequested, options, enabled, readOnly)}
        validation={validation}
        help={help}
        session={form}
        fieldId={fieldId}
        participation={participation}
        required={required}
        style={style}
    />
}
