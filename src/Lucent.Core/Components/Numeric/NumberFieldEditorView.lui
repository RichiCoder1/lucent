namespace Lucent.Core;
using System;

internal component NumberFieldEditorView(
    FieldContext field,
    NumericEditSession session,
    Func<bool>? enabled,
    Func<bool>? readOnly,
    Action decrease,
    Action increase,
    Style decreaseStyle,
    Style increaseStyle
) {
    <NumberFieldHost
        session={session}
        label={field.AccessibleName}
        enabled={enabled}
        readOnly={readOnly}
    >
        <NumberFieldTextField
            field={field}
            session={session}
            enabled={enabled}
            readOnly={readOnly}
        />
        <NumberFieldStep
            source={DateTimeArtwork.Decrease}
            label={"Decrease " + field.AccessibleName}
            onInvoke={decrease}
            style={decreaseStyle}
        />
        <NumberFieldStep
            source={DateTimeArtwork.Increase}
            label={"Increase " + field.AccessibleName}
            onInvoke={increase}
            style={increaseStyle}
        />
    </NumberFieldHost>
}
