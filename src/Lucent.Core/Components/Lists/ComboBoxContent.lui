namespace Lucent.Core;

style ComboBoxEditorStyle {
    MainGrow: 1;
}

style ComboBoxChevronStyle {
    Width: 20;
    Height: 20;
}

internal component ComboBoxContent(ComboBoxBinding binding, ComponentRecipe editor, Style? style) {
    <ComboBoxHost binding={binding} style={style}>
        <Layout style={ComboBoxEditorStyle}>
            {editor}
        </Layout>
        <Icon source={() => NavigationArtwork.Expanded} style={ComboBoxChevronStyle} />
    </ComboBoxHost>
}
