<Project>
  <PropertyGroup>
    <LucentLuiProjectEpoch Condition="'$(LucentLuiProjectEpoch)' == ''">$(MSBuildProjectFullPath)|$(TargetFramework)|$(Configuration)</LucentLuiProjectEpoch>
    <LucentLuiCompilerOptions Condition="'$(LucentLuiCompilerOptions)' == ''">LangVersion=$(LangVersion)|Nullable=$(Nullable)|ImplicitUsings=$(ImplicitUsings)|Optimize=$(Optimize)|WarningLevel=$(WarningLevel)|TreatWarningsAsErrors=$(TreatWarningsAsErrors)</LucentLuiCompilerOptions>
    <LucentLuiDefines Condition="'$(LucentLuiDefines)' == ''">$(DefineConstants)</LucentLuiDefines>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)Assets.targets" />

  <Target Name="ValidateLucentLuiLangVersion" BeforeTargets="CoreCompile" Condition="'$(LucentEnableLui)' != 'false'">
    <Error Condition="'$(LucentLuiLangVersion)' != 'preview'" Text="LucentLuiLangVersion must be 'preview' for this SDK proof." />
  </Target>
  <Target Name="CheckLucentLuiFormat" BeforeTargets="CoreCompile" Condition="'$(LucentEnableLui)' != 'false' and '$(LucentLuiFormatCheck)' == 'true'">
    <ItemGroup><_LucentLuiFormatInput Include="@(AdditionalFiles)" Condition="'%(Extension)' == '.lui'" /></ItemGroup>
    <Exec Condition="'@(_LucentLuiFormatInput)' != ''" Command="dotnet &quot;$(MSBuildThisFileDirectory)..\tools\net10.0\Lucent.Lui.Tooling.dll&quot; --check @(_LucentLuiFormatInput->'&quot;%(FullPath)&quot;', ' ')" />
  </Target>
  <ItemGroup Condition="'$(LucentEnableLui)' != 'false'">
    <AdditionalFiles Update="@(AdditionalFiles)">
      <LucentLuiLogicalPath Condition="'%(AdditionalFiles.LucentLuiLogicalPath)' == ''">$([MSBuild]::MakeRelative('$(MSBuildProjectDirectory)', '%(AdditionalFiles.FullPath)'))</LucentLuiLogicalPath>
    </AdditionalFiles>
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="LucentLuiLogicalPath" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="LucentLuiDocumentVersion" />
    <CompilerVisibleProperty Include="LucentLuiProjectIdentity" />
    <CompilerVisibleProperty Include="LucentLuiProjectEpoch" />
    <CompilerVisibleProperty Include="LucentLuiLangVersion" />
    <CompilerVisibleProperty Include="LucentLuiCompilerOptions" />
    <CompilerVisibleProperty Include="LucentLuiDefines" />
    <CompilerVisibleProperty Include="RootNamespace" />
    <Analyzer Include="$(MSBuildThisFileDirectory)..\analyzers\dotnet\cs\Lucent.Lui.Compiler.dll" />
    <Analyzer Include="$(MSBuildThisFileDirectory)..\analyzers\dotnet\cs\Lucent.Lui.Generator.dll" />
  </ItemGroup>
  <ItemGroup Condition="'$(LucentEnableLui)' == 'false'">
    <AdditionalFiles Remove="@(AdditionalFiles->WithMetadataValue('Extension', '.lui'))" />
    <Analyzer Include="$(MSBuildThisFileDirectory)..\analyzers\dotnet\cs\Lucent.Lui.Generator.dll" />
  </ItemGroup>
  <ItemGroup Condition="'$(LucentLuiImplicitUsings)' == 'true'">
    <Using Include="Lucent.Core" />
  </ItemGroup>
  <Target Name="CleanLucentLuiGeneratedFiles" AfterTargets="CoreClean" Condition="'$(EmitCompilerGeneratedFiles)' == 'true'">
    <RemoveDir Directories="$(CompilerGeneratedFilesOutputPath)\Lucent.Lui.Generator" />
  </Target>
  <Target Name="ResetLucentLuiGeneratedFiles" BeforeTargets="PrepareForBuild" Condition="'$(EmitCompilerGeneratedFiles)' == 'true'">
    <RemoveDir Directories="$(CompilerGeneratedFilesOutputPath)\Lucent.Lui.Generator" />
  </Target>
</Project>
