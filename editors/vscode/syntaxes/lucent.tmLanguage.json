{
  "name": "Lucent",
  "scopeName": "source.lucent",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#foreach" },
    { "include": "#declarations" },
    { "include": "#modifiers" },
    { "include": "#keywords" },
    { "include": "#controls" },
    { "include": "#properties" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "source.cs" }
  ],
  "repository": {
    "foreach": {
      "patterns": [
        {
          "match": "\\b(foreach)\\s*(\\()\\s*(var)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(in)\\b",
          "captures": {
            "1": { "name": "keyword.control.loop.foreach.cs" },
            "2": { "name": "punctuation.section.group.begin.cs" },
            "3": { "name": "storage.type.implicit.cs" },
            "4": { "name": "variable.other.local.cs" },
            "5": { "name": "keyword.control.loop.in.cs" }
          }
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.lucent",
          "match": "//.*$"
        },
        {
          "name": "comment.block.lucent",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.lucent",
          "begin": "(?:\\$@|@\\$|\\$|@)?\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.lucent",
              "match": "\\\\."
            },
            {
              "name": "punctuation.section.interpolation.begin.lucent",
              "match": "(?<!\\{)\\{(?!\\{)"
            },
            {
              "name": "punctuation.section.interpolation.end.lucent",
              "match": "(?<!\\})\\}(?!\\})"
            }
          ]
        },
        {
          "name": "string.quoted.raw.lucent",
          "begin": "\"\"\"",
          "end": "\"\"\""
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(namespace)\\s+([A-Za-z_][A-Za-z0-9_.]*)",
          "captures": {
            "1": { "name": "keyword.other.namespace.lucent" },
            "2": { "name": "entity.name.namespace.lucent" }
          }
        },
        {
          "match": "\\b(using)\\s+([A-Za-z_][A-Za-z0-9_.]*)",
          "captures": {
            "1": { "name": "keyword.other.using.lucent" },
            "2": { "name": "entity.name.namespace.lucent" }
          }
        },
        {
          "match": "\\b(component)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.component.lucent" },
            "2": { "name": "entity.name.type.component.lucent" }
          }
        },
        {
          "match": "\\b(Fragment)\\s+(Render)\\b",
          "captures": {
            "1": { "name": "storage.type.lucent" },
            "2": { "name": "entity.name.function.render.lucent" }
          }
        },
        {
          "match": "\\b(State|Computed)\\s*(<)\\s*([^>]+)\\s*(>)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "support.type.reactive.lucent" },
            "2": { "name": "punctuation.definition.generic.begin.lucent" },
            "3": { "name": "storage.type.cs" },
            "4": { "name": "punctuation.definition.generic.end.lucent" },
            "5": { "name": "variable.other.member.lucent" }
          }
        }
      ]
    },
    "modifiers": {
      "patterns": [
        {
          "name": "storage.modifier.lucent",
          "match": "\\b(public|private|protected|internal|static|readonly|sealed|partial|abstract|virtual|override|async)\\b"
        },
        {
          "name": "storage.type.primitive.cs",
          "match": "\\b(bool|byte|char|decimal|double|float|int|long|object|sbyte|short|string|uint|ulong|ushort|void)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.lucent",
          "match": "\\b(if|else|foreach|keyed|by|return|new|slot|yield|context)\\b"
        },
        {
          "name": "keyword.operator.word.cs",
          "match": "\\b(is|as|in|not|and|or|await)\\b"
        }
      ]
    },
    "controls": {
      "patterns": [
        {
          "name": "support.class.component.lucent",
          "match": "\\b[A-Z][A-Za-z0-9_]*(?=\\s*(?:\\(|\\{))"
        },
        {
          "name": "support.type.cs",
          "match": "\\b[A-Z][A-Za-z0-9_]*(?=\\s*[.<])"
        }
      ]
    },
    "properties": {
      "patterns": [
        {
          "name": "entity.other.attribute-name.lucent",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*:)"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.cs",
          "match": "\\b(true|false|null)\\b"
        },
        {
          "name": "constant.numeric.cs",
          "match": "\\b(?:0[xX][0-9A-Fa-f_]+|0[bB][01_]+|(?:\\d[\\d_]*)(?:\\.[\\d_]*)?(?:[eE][+-]?[\\d_]+)?)[dDfFmMuUlL]*\\b"
        },
        {
          "name": "constant.other.enum.cs",
          "match": "(?<=\\.)[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.cs",
          "match": "=>|\\?\\?|\\?\\.|==|!=|<=|>=|&&|\\|\\||\\+\\+|--|[+\\-*/%!=<>?]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.lucent",
          "match": "[;:,.]"
        },
        {
          "name": "punctuation.definition.block.lucent",
          "match": "[{}()]"
        },
        {
          "name": "punctuation.definition.generic.lucent",
          "match": "[\\[\\]]"
        }
      ]
    }
  }
}
