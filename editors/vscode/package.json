{
  "name": "lucent-vscode",
  "displayName": "Lucent",
  "description": "Language support for the Lucent compiled declarative UI language.",
  "version": "0.1.0",
  "publisher": "lucent",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./extension.js",
  "files": [
    "extension.js",
    "language-configuration.json",
    "node_modules",
    "syntaxes",
    "server"
  ],
  "activationEvents": [
    "onLanguage:lucent"
  ],
  "contributes": {
    "languages": [
      {
        "id": "lucent",
        "aliases": [
          "Lucent",
          "lui"
        ],
        "extensions": [
          ".lui"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lucent",
        "scopeName": "source.lucent",
        "path": "./syntaxes/lucent.tmLanguage.json",
        "embeddedLanguages": {
          "source.cs": "csharp"
        }
      }
    ],
    "commands": [
      {
        "command": "lucent.showLanguageServerOutput",
        "title": "Lucent: Show Language Server Output"
      }
    ],
    "configuration": {
      "title": "Lucent",
      "properties": {
        "lucent.languageServer.command": {
          "type": "string",
          "default": "dotnet",
          "description": "Executable used to launch the Lucent language server."
        },
        "lucent.languageServer.path": {
          "type": "string",
          "default": "server/Lucent.LanguageServer.dll",
          "description": "Path to the net9 Lucent language-server assembly, relative to this extension when not absolute."
        },
        "lucent.languageServer.trace": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "messages",
          "description": "Structured language-server tracing written to the Lucent output channel."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "prepare-server": "pwsh -NoProfile -File scripts/prepare-server.ps1",
    "vscode:prepublish": "npm run prepare-server"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.0"
  }
}
