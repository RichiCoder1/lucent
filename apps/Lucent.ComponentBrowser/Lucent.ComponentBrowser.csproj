<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
    <RootNamespace>Lucent.ComponentBrowser</RootNamespace>
    <LucentLuiLangVersion>preview</LucentLuiLangVersion>
    <LucentLuiProjectIdentity>$(MSBuildProjectFullPath)</LucentLuiProjectIdentity>
    <LucentLuiProjectEpoch>$(MSBuildProjectFullPath)|$(TargetFramework)|$(Configuration)|$(MSBuildProjectExtensionsPath)|$(LangVersion)|$(Nullable)|$(DefineConstants)|@(ReferencePath)|@(Using)</LucentLuiProjectEpoch>
    <LucentLuiCompilerOptions>$(LangVersion)|$(Nullable)|$(DefineConstants)|@(ReferencePath)|@(Using)</LucentLuiCompilerOptions>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Lucent.Core" />
    <ProjectReference Include="../../src/Lucent.Core/Lucent.Core.csproj" />
    <ProjectReference Include="../../src/Lucent.Icons.Lucide/Lucent.Icons.Lucide.csproj" />
    <ProjectReference Include="../../src/Lucent.Platform.Windows/Lucent.Platform.Windows.csproj" />
    <ProjectReference Include="../../src/Lucent.Lui.Compiler/Lucent.Lui.Compiler.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot;PublishTrimmed;RuntimeIdentifier;SelfContained" />
    <ProjectReference Include="../../src/Lucent.Lui.Generator/Lucent.Lui.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot;PublishTrimmed;RuntimeIdentifier;SelfContained" />
    <ProjectReference Include="../../src/Lucent.Lui.Tooling/Lucent.Lui.Tooling.csproj" ReferenceOutputAssembly="false" Private="false" PrivateAssets="all" SkipGetTargetFrameworkProperties="true" GlobalPropertiesToRemove="PublishAot;PublishTrimmed;RuntimeIdentifier;SelfContained" />
  </ItemGroup>
  <ItemGroup>
    <!-- The compiler consumes these files as AdditionalFiles; embedding the same bytes gives the browser an honest source view. -->
    <EmbeddedResource Include="Examples\*.lui" LogicalName="Lucent.ComponentBrowser.Examples.%(Filename)%(Extension)" />
    <AdditionalFiles Include="*.lui" LucentLuiLogicalPath="%(Filename)%(Extension)" />
    <AdditionalFiles Include="Examples\*.lui" LucentLuiLogicalPath="Examples/%(Filename)%(Extension)" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="LucentLuiLogicalPath" />
    <CompilerVisibleProperty Include="LucentLuiProjectIdentity" />
    <CompilerVisibleProperty Include="LucentLuiProjectEpoch" />
    <CompilerVisibleProperty Include="LucentLuiCompilerOptions" />
    <CompilerVisibleProperty Include="LucentLuiLangVersion" />
  </ItemGroup>
  <Target Name="PrepareLucentLuiProjectContext" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <LucentLuiProjectEpoch>$(MSBuildProjectFullPath)|$(TargetFramework)|$(Configuration)|$(LangVersion)|$(Nullable)|$(DefineConstants)|@(ReferencePath)|@(Using)</LucentLuiProjectEpoch>
      <LucentLuiCompilerOptions>$(LangVersion)|$(Nullable)|$(DefineConstants)|@(ReferencePath)|@(Using)</LucentLuiCompilerOptions>
    </PropertyGroup>
  </Target>
  <PropertyGroup>
    <LucentAssetOutputDirectory>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\lucent-assets\</LucentAssetOutputDirectory>
    <LucentAssetToolPath>$(MSBuildProjectDirectory)\..\..\src\Lucent.Lui.Tooling\bin\$(Configuration)\net10.0\Lucent.Lui.Tooling.dll</LucentAssetToolPath>
    <LucentAssetToolDirectory>$(MSBuildProjectDirectory)\..\..\src\Lucent.Lui.Tooling\bin\$(Configuration)\net10.0</LucentAssetToolDirectory>
  </PropertyGroup>
  <Import Project="../../src/Lucent.Lui.Sdk/Sdk/Assets.targets" />
</Project>
