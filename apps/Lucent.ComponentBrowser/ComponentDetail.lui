namespace Lucent.ComponentBrowser;

style ComponentDetailStyle {
    MainGrow: 1;
    MainShrink: 1;
    MinWidth: 0;
    MinHeight: 0;
    Clip: true;
}

style ComponentDetailContentStyle {
    Axis: LayoutAxis.Column;
    Padding: Insets.Symmetric(24, 24);
    Spacing: 16;
    MainGrow: 1;
    MainShrink: 1;
    MinWidth: 0;
}

style ComponentDetailViewportStyle {
    MainGrow: 1;
    MainShrink: 1;
    MinWidth: 0;
    MinHeight: 0;
    Clip: true;
    Visibility: ScrollBarVisibility.Auto;
}

style ComponentDetailHeadingStyle {
    Axis: LayoutAxis.Column;
    Spacing: 5;
}

style ComponentDetailActionStyle {
    Axis: LayoutAxis.Row;
    Spacing: 10;
    CrossAlignment: LayoutAlignment.Center;
    Wrap: true;
}

style ComponentStateRowStyle {
    Axis: LayoutAxis.Row;
    Spacing: 8;
    RowGap: 8;
    CrossAlignment: LayoutAlignment.Center;
    Wrap: true;
    TextWrap: TextWrap.NoWrap;
}

style ComponentExampleStyle {
    Axis: LayoutAxis.Column;
    Padding: Insets.Uniform(16);
    Spacing: 12;
    MinWidth: 0;
}

public component ComponentDetail(ComponentBrowserState browser, ComponentBrowserViewState view) {
    readonly IReadOnlyList<RadioOption<ExampleState>> stateOptions = [
        new(ExampleState.Default, "Default"),
        new(ExampleState.Disabled, "Disabled"),
        new(ExampleState.Busy, "Busy"),
        new(ExampleState.Error, "Error"),
    ];

    <Layout style={ComponentDetailStyle}>
        <ScrollViewport
            viewport={view.DetailViewport}
            label="Component details"
            style={ComponentDetailViewportStyle}
        >
            <Layout style={ComponentDetailContentStyle}>
                <Layout style={ComponentDetailHeadingStyle}>
                    <Text style={PresentationStyles.Caption}>
                        {() => browser.SelectedItem.Family.ToUpperInvariant()}
                    </Text>
                    <Text
                        style={PresentationStyles.Title with {
                            TextWrap: TextWrap.WordWithGraphemeFallback;
                        }}
                        name="component-browser.detail-title"
                    >
                        {() => browser.SelectedItem.Title}
                    </Text>
                    <Text
                        style={PresentationStyles.Body with {
                            TextWrap: TextWrap.WordWithGraphemeFallback;
                        }}
                    >
                        {() => browser.SelectedItem.Summary}
                    </Text>
                </Layout>
                <Layout style={ComponentStateRowStyle}>
                    <RadioGroup
                        label="Example state"
                        items={() => stateOptions}
                        readSelectedKey={() => browser.CurrentExampleState}
                        onSelectionRequested={browser.SetExampleState}
                        optionsStyle={ComponentStateRowStyle}
                        name="component-browser.state"
                    />
                    <Status
                        content={() => browser.ExampleStateLabel}
                        style={PresentationStyles.Secondary}
                        name="component-browser.state-status"
                    />
                </Layout>
                <Layout style={ComponentDetailActionStyle}>
                    <Button
                        onInvoke={browser.Back}
                        style={
                            Style.Empty.ButtonRole(ButtonRole.Secondary).Enabled(
                                () => browser.Navigation.CanGoBack
                            )
                        }
                        name="component-browser.back"
                    >
                        Back
                    </Button>
                    <Button
                        onInvoke={browser.Forward}
                        style={
                            Style.Empty.ButtonRole(ButtonRole.Secondary).Enabled(
                                () => browser.Navigation.CanGoForward
                            )
                        }
                        name="component-browser.forward"
                    >
                        Forward
                    </Button>
                    <Button
                        leadingIcon={Lucent.Icons.Lucide.LucideIcons.FileText}
                        onInvoke={browser.CopySource}
                        name="component-browser.copy-source"
                    >
                        Copy compiled .lui
                    </Button>
                    <Status
                        content={() => browser.CopyMessage}
                        style={PresentationStyles.Secondary}
                        name="component-browser.copy-status"
                    />
                </Layout>
                <Divider />
                <Text style={PresentationStyles.Caption}>INTERACTIVE EXAMPLE</Text>
                <Layout style={ComponentExampleStyle}>
                    <RouterOutlet
                        options={new RouteOutletOptions(interaction: browser.Interaction)}
                        name="component-browser.example"
                    />
                </Layout>
                <SourcePanel browser={browser} view={view} name="component-browser.source-panel" />
                <Divider />
                <Text style={PresentationStyles.Caption}>USAGE</Text>
                <Text
                    style={PresentationStyles.Body with {
                        TextWrap: TextWrap.WordWithGraphemeFallback;
                    }}
                    name="component-browser.usage"
                >
                    {() => browser.SelectedItem.Usage}
                </Text>
                <Text style={PresentationStyles.Caption}>ACCESSIBILITY</Text>
                <Text
                    style={PresentationStyles.Body with {
                        TextWrap: TextWrap.WordWithGraphemeFallback;
                    }}
                    name="component-browser.accessibility"
                >
                    {() => browser.SelectedItem.Accessibility}
                </Text>
            </Layout>
        </ScrollViewport>
    </Layout>
}
