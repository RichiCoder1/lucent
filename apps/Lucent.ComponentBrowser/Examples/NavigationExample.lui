namespace Lucent.ComponentBrowser;

style NavigationExampleStyle {
    Axis: LayoutAxis.Column;
    Spacing: 14;
    MinWidth: 0;
}

style NavigationExampleChoiceStyle {
    MainGrow: 1;
    MainShrink: 1;
    MinWidth: 220;
}

style NavigationExampleDialogBodyStyle {
    Axis: LayoutAxis.Column;
    Spacing: 8;
}

public component NavigationExample(ComponentBrowserState browser) {
    readonly NavigationExampleModel example = new(owner, browser.UriLauncher);

    <Layout style={NavigationExampleStyle}>
        <Text style={PresentationStyles.Body with { TextWrap: TextWrap.WordWithGraphemeFallback; }}>
            These recipes keep navigation policy and modal lifetime explicit. Select an item, switch tabs, expand the disclosure, follow the typed link, or open the dialog to inspect focus and completion owned by this mounted example.
        </Text>
        <Tabs
            label="Navigation contract"
            items={() => example.TabItems}
            readSelectedKey={() => example.TabSelection}
            onSelectionRequested={example.SetTabSelection}
            activation={TabActivationMode.Automatic}
            name="component-browser.navigation.tabs"
        />
        <Layout style={NavigationExampleChoiceStyle}>
            <ListBox
                label="Visible choices"
                items={() => example.ListItems}
                readSelectedKey={() => example.ListSelection}
                onSelectionRequested={example.SetListSelection}
                name="component-browser.navigation.list"
            />
            <Select
                label="Compact choice"
                items={() => example.SelectItems}
                readSelectedKey={() => example.SelectSelection}
                onSelectionRequested={example.SetSelectSelection}
                name="component-browser.navigation.select"
            />
        </Layout>
        <Disclosure
            heading="Why the selection is controlled"
            readExpanded={() => example.DisclosureExpanded}
            onExpandedRequested={example.SetDisclosureExpanded}
            name="component-browser.navigation.disclosure"
        >
            <Text
                style={PresentationStyles.Body with { TextWrap: TextWrap.WordWithGraphemeFallback; }}
            >
                This example owns its selected keys for the lifetime of the route. Leaving and returning remounts its defaults. The stock controls keep keyboard movement, applied selection, and semantic relationships separate.
            </Text>
        </Disclosure>
        <Link onInvoke={example.SetLinkMessage} name="component-browser.navigation.link">
            Read the navigation contract
        </Link>
        <Link
            onInvoke={example.OpenDocumentation}
            name="component-browser.navigation.external-link"
        >
            Open Lucent documentation in your browser
        </Link>
        <Status
            content={() => example.LinkMessage}
            style={PresentationStyles.Secondary}
            name="component-browser.navigation.link-status"
        />
        <Button
            onInvoke={example.OpenDialog}
            style={Style.Empty.Enabled(() => !example.Dialog.IsOpen)}
            name="component-browser.navigation.open-dialog"
        >
            Review changes
        </Button>
        <Status
            content={() => example.DialogMessage}
            style={PresentationStyles.Secondary}
            name="component-browser.navigation.dialog-status"
        />
        <Dialog
            controller={example.Dialog}
            title="Review component changes"
            actions={
                [
                    Lucent.Core.Components.Button("Apply changes", example.SubmitDialog),
                    Lucent.Core.Components.DialogCancel("Cancel", example.CancelDialog)
                ]
            }
            defaultAccept={example.SubmitDialog}
            initialFocus={example.FocusDialog}
        >
            <Layout style={NavigationExampleDialogBodyStyle}>
                <Text
                    style={PresentationStyles.Body with {
                        TextWrap: TextWrap.WordWithGraphemeFallback;
                    }}
                >
                    The typed dialog session keeps its mounted owner, modal focus, and accepted write separate from the surrounding browser.
                </Text>
                <Text>1. The list selection stays controlled.</Text>
                <Text>2. The link remains a named action.</Text>
                <Text>3. The default action runs only when the dialog owns focus.</Text>
                <Text>4. Escape cancels the session when no IME composition is active.</Text>
                <Text>5. A pending application write keeps its accepted value alive.</Text>
                <Text>6. The action row stays available while this body scrolls.</Text>
                <Text>7. Closing the surface returns focus to the invoking action.</Text>
                <Text>8. Accessibility clients receive the dialog title and relationships.</Text>
                <Text>9. The owner may safely dispose while the application work finishes.</Text>
                <Text>10. This example uses the same public controller API authors can adopt.</Text>
            </Layout>
        </Dialog>
    </Layout>
}
