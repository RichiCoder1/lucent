namespace Lucent.ComponentBrowser;
style PasswordExampleStyle {
    Axis: LayoutAxis.Column;
    Spacing: 12;
    MinWidth: 0;
}

style PasswordExampleFieldStyle {
    MainGrow: 1;
    MainShrink: 1;
    MinWidth: 240;
}

public component PasswordExample(ComponentBrowserState browser) {
    string passwordValue = "sample-only-value";
    string passwordMessage = "The fake value is masked and never echoed.";
    readonly PasswordFieldOptions passwordOptions = new(historyLimit: 4);
    void SetPasswordValue(string value) {
        passwordValue = value;
        passwordMessage = "The fake value changed; the browser keeps it masked.";
    }
    ValidationState PasswordValidation() {
        return passwordValue.Length >= 8
            ? ValidationState.Valid
            : ValidationState.Invalid("Use at least eight characters for this example.");
    }
    <Layout style={PasswordExampleStyle}>
        <Text style={PresentationStyles.Body with { TextWrap: TextWrap.WordWithGraphemeFallback; }}>This example uses a fake value so the browser can demonstrate confidential editing without displaying or copying a credential.</Text>
        <PasswordField label="Example password" value={() => passwordValue} onChangeRequested={SetPasswordValue} options={passwordOptions} validation={PasswordValidation} help={() => "The value is masked, never echoed in status text, and remasked after focus leaves the editor."} required={true} style={PasswordExampleFieldStyle} name="component-browser.password.field" />
        <Status content={() => passwordMessage} style={PresentationStyles.Secondary} name="component-browser.password.status" />
    </Layout>
}
