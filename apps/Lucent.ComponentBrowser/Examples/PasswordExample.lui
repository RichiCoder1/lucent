namespace Lucent.ComponentBrowser;

style PasswordExampleStyle {
    Axis: LayoutAxis.Column;
    Spacing: 12;
    MinWidth: 0;
}

style PasswordExampleFieldStyle {
    MainGrow: 1;
    MainShrink: 1;
    MinWidth: 240;
}

public component PasswordExample(ComponentBrowserState browser) {
    <Layout style={PasswordExampleStyle}>
        <Text style={PresentationStyles.Body with { TextWrap: TextWrap.WordWithGraphemeFallback; }}>This example uses a fake value so the browser can demonstrate confidential editing without displaying or copying a credential.</Text>
        <PasswordField
            label="Example password"
            value={() => browser.PasswordValue}
            onChangeRequested={browser.SetPasswordValue}
            options={browser.PasswordOptions}
            validation={() => browser.PasswordValidation}
            help={() => "The value is masked, never echoed in status text, and remasked after focus leaves the editor."}
            required={true}
            style={PasswordExampleFieldStyle}
            name="component-browser.password.field"
        />
        <Status content={() => browser.PasswordMessage} style={PresentationStyles.Secondary} name="component-browser.password.status" />
    </Layout>
}
