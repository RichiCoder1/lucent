namespace Lucent.ComponentBrowser;

style BrowserHeaderStyle {
    Axis: LayoutAxis.Column;
    Padding: Insets.Symmetric(24, 18);
    Spacing: 14;
    MainShrink: 0;
}

style HeaderTopStyle {
    Axis: LayoutAxis.Row;
    Spacing: 18;
    CrossAlignment: LayoutAlignment.Center;
    Wrap: true;
}

style HeaderTitleStyle {
    Axis: LayoutAxis.Column;
    Spacing: 3;
    MainGrow: 1;
    MainShrink: 1;
    MinWidth: 260;
}

style HeaderActionsStyle {
    Axis: LayoutAxis.Row;
    Spacing: 8;
    Wrap: false;
    MainShrink: 0;
    CrossAlignment: LayoutAlignment.End;
}

style HeaderThemeOptionsStyle {
    Axis: LayoutAxis.Row;
    Spacing: 8;
    RowGap: 8;
    Wrap: true;
    TextWrap: TextWrap.NoWrap;
}

style HeaderSearchStyle {
    MainGrow: 1;
    MainShrink: 1;
    MinWidth: 240;
}

style HeaderSearchRowStyle {
    Axis: LayoutAxis.Row;
    Spacing: 10;
    CrossAlignment: LayoutAlignment.Center;
    Wrap: true;
}

public component BrowserHeader(ComponentBrowserState browser, ThemeContext theme) {
    readonly IReadOnlyList<RadioOption<ThemeAppearance>> themeOptions = [
        new(ThemeAppearance.Light, "Light"),
        new(new ThemeAppearance(ThemeColorScheme.Dark, ThemeContrast.Normal), "Dark"),
        new(new ThemeAppearance(ThemeColorScheme.Light, ThemeContrast.High), "High contrast"),
    ];

    <Layout style={BrowserHeaderStyle}>
        <Layout style={HeaderTopStyle}>
            <Layout style={HeaderTitleStyle}>
                <Text style={PresentationStyles.Title} name="component-browser.title">
                    Components
                </Text>
                <Text style={PresentationStyles.Secondary}>
                    Stock recipes, working examples, and source you can take with you.
                </Text>
            </Layout>
            <Layout style={HeaderActionsStyle}>
                <RadioGroup
                    label="Theme"
                    items={() => themeOptions}
                    readSelectedKey={() => theme.Appearance}
                    onSelectionRequested={
                        appearance => ComponentBrowserTheme.SetAppearance(theme, appearance)
                    }
                    optionsStyle={HeaderThemeOptionsStyle}
                    name="component-browser.theme"
                />
                <Button
                    leadingIcon={Lucent.Icons.Lucide.LucideIcons.ListFilter}
                    onInvoke={browser.ToggleDensity}
                    style={Style.Empty.ButtonRole(ButtonRole.Secondary)}
                    name="component-browser.density"
                >
                    {
                        browser.Density == BrowserDensity.Comfortable
                            ? "Density: comfortable"
                            : "Density: compact"
                    }
                </Button>
            </Layout>
        </Layout>
        <Layout style={HeaderSearchRowStyle}>
            <Layout style={HeaderSearchStyle}>
                <Text style={PresentationStyles.Caption}>Find a component</Text>
                <TextField
                    session={browser.SearchEditor}
                    onChange={browser.SetSearch}
                    label="Search components"
                    placeholder="Search by name, family, or purpose"
                    name="component-browser.search"
                />
            </Layout>
            <Status style={PresentationStyles.Secondary} name="component-browser.result-count">
                {
                    () => browser.VisibleItems.Count + " of " + ComponentCatalog.Items.Count
                        + " recipes"
                }
            </Status>
        </Layout>
    </Layout>
}
