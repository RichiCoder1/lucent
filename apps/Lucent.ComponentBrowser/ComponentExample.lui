namespace Lucent.ComponentBrowser;

public component ComponentExample(ComponentBrowserState browser) {
    <Layout>
        if (browser.SelectedId == "buttons") {
            <ButtonsExample browser={browser} />
        }
        if (browser.SelectedId == "fields") {
            <FieldsExample browser={browser} />
        }
        if (browser.SelectedId == "password") {
            <PasswordExample browser={browser} />
        }
        if (browser.SelectedId == "combo-box") {
            <ComboBoxExample browser={browser} />
        }
        if (browser.SelectedId == "selection") {
            <SelectionExample browser={browser} />
        }
        if (browser.SelectedId == "feedback") {
            <FeedbackExample browser={browser} />
        }
        if (browser.SelectedId == "menus") {
            <MenusExample browser={browser} />
        }
        if (browser.SelectedId == "surfaces") {
            <PopoverExample browser={browser} />
        }
        if (browser.SelectedId == "numeric") {
            <NumericExample browser={browser} />
        }
        if (browser.SelectedId == "date-time") {
            <DateTimeExample browser={browser} />
        }
        if (browser.SelectedId == "navigation") {
            <NavigationExample browser={browser} />
        }
        if (browser.SelectedId == "tree") {
            <TreeExample browser={browser} />
        }
        if (browser.SelectedId == "storage") {
            <StorageExample browser={browser} />
        }
        if (browser.SelectedId == "table") {
            <TableExample browser={browser} />
        }
    </Layout>
}
