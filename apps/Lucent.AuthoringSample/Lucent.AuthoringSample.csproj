<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
    <RootNamespace>Lucent.AuthoringSample</RootNamespace>
    <LangVersion>preview</LangVersion>
    <LucentLuiLangVersion>preview</LucentLuiLangVersion>
    <LucentLuiNamedComponents>true</LucentLuiNamedComponents>
    <LucentLuiPreparedAuthoring>true</LucentLuiPreparedAuthoring>
    <LucentLuiProjectIdentity>$(MSBuildProjectFullPath)</LucentLuiProjectIdentity>
    <LucentLuiProjectEpoch>$(MSBuildProjectFullPath)|$(TargetFramework)|$(Configuration)|$(MSBuildProjectExtensionsPath)|$(LangVersion)|$(Nullable)|$(DefineConstants)|@(ReferencePath)|@(Using)</LucentLuiProjectEpoch>
    <LucentLuiCompilerOptions>$(LangVersion)|$(Nullable)|$(DefineConstants)|@(ReferencePath)|@(Using)</LucentLuiCompilerOptions>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)\generated\**;$(MSBuildProjectDirectory)\lucent-preparation\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Lucent.Core" />
    <ProjectReference Include="../../src/Lucent.Core/Lucent.Core.csproj" />
    <ProjectReference Include="../../src/Lucent.Platform.Windows/Lucent.Platform.Windows.csproj" />
    <ProjectReference
      Include="../../src/Lucent.Lui.Compiler/Lucent.Lui.Compiler.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      GlobalPropertiesToRemove="PublishAot;PublishTrimmed;RuntimeIdentifier;SelfContained"
    />
    <ProjectReference
      Include="../../src/Lucent.Lui.Generator/Lucent.Lui.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      GlobalPropertiesToRemove="PublishAot;PublishTrimmed;RuntimeIdentifier;SelfContained"
    />
    <ProjectReference
      Include="../../src/Lucent.Lui.Tooling/Lucent.Lui.Tooling.csproj"
      ReferenceOutputAssembly="false"
      Private="false"
      PrivateAssets="all"
      SkipGetTargetFrameworkProperties="true"
      GlobalPropertiesToRemove="PublishAot;PublishTrimmed;RuntimeIdentifier;SelfContained"
    />
    <AdditionalFiles Include="*.lui" LucentLuiLogicalPath="%(Filename)%(Extension)" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="LucentLuiLogicalPath" />
    <CompilerVisibleProperty Include="LucentLuiProjectIdentity" />
    <CompilerVisibleProperty Include="LucentLuiProjectEpoch" />
    <CompilerVisibleProperty Include="LucentLuiCompilerOptions" />
    <CompilerVisibleProperty Include="LucentLuiLangVersion" />
    <CompilerVisibleProperty Include="LucentLuiPreparedAuthoring" />
  </ItemGroup>
  <Target Name="PrepareLucentLuiProjectContext" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <LucentLuiProjectEpoch>$(MSBuildProjectFullPath)|$(TargetFramework)|$(Configuration)|$(LangVersion)|$(Nullable)|$(DefineConstants)|@(ReferencePath)|@(Using)</LucentLuiProjectEpoch>
      <LucentLuiCompilerOptions>$(LangVersion)|$(Nullable)|$(DefineConstants)|@(ReferencePath)|@(Using)</LucentLuiCompilerOptions>
    </PropertyGroup>
  </Target>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="../../eng/LuiSourcePreparation.targets" />
  <PropertyGroup>
    <CompilerGeneratedFilesOutputPath>$(IntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
</Project>
