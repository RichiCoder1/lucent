namespace Lucent.IssueBrowser;

style DetailPaneStyle {
    Axis: LayoutAxis.Column;
    MainGrow: 1;
    MinWidth: 0;
    MinHeight: 0;
    Clip: true;
    Padding: Insets.Uniform(24);
    Spacing: 16;
}

style DetailBackStyle(WindowBreakpoints breakpoints) {
    Participation: ElementParticipation.Collapsed;
    when (!breakpoints.IsActive(IssueBrowserBreakpoints.Wide)) {
        Participation: ElementParticipation.Visible;
    }
}

public component IssueDetailPane() {
    context IssueBrowserViewState view;
    context NavigationSession navigation;

    <Layout style={DetailPaneStyle}>
        <Button
            leadingIcon={Lucent.Icons.Lucide.LucideIcons.ArrowLeft}
            onInvoke={() => navigation.Back()}
            style={DetailBackStyle(view.Breakpoints)}
            name="issue-browser.back"
        >
            Back
        </Button>
        {IssueBrowserRouting.Outlet(view.Interaction)}
    </Layout>
}
