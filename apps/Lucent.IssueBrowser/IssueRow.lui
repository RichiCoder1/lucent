namespace Lucent.IssueBrowser;
style IssueRowStyle {
    Spacing: DensitySpacing;
    FontSize: DensityFontSize;
    Background: RowSurface;
    when FocusVisible {
        Background: FocusSurface;
        TextColor: FocusForeground;
    }
}

public component IssueRow(IssueBrowserState browser, BrowserIssue issue) {
    <Selectable content={() => Label(browser, issue)} selected={() => browser.IsSelected(issue.Number)} onSelect={() => browser.Select(issue.Number)} style={IssueRowStyle with { Height: browser.Density == IssueDensity.Comfortable ? 30 : 22; }} />
}
