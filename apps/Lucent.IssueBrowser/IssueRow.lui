namespace Lucent.IssueBrowser;

public component IssueRow(IssueBrowserState browser, Func<BrowserIssue> issue, IssueBrowserViewState? view = null) {
    <ContextMenu menu={() => IssueRowMenu(browser, issue, view)} name="issue-browser.issue-row-menu">
        <Selectable label={() => Label(issue())} selected={() => browser.IsSelected(issue().Number)} onSelect={() => OpenIssue(browser, issue().Number, view)} style={IssueRowLayout(view)}>
            <Text style={IssueRowBodyStyle} content={() => issue().Title} />
            <Text style={IssueRowCaptionStyle} content={() => "#" + issue().Number + " · " + issue().Status + " · " + issue().Assignee} />
        </Selectable>
    </ContextMenu>
}
