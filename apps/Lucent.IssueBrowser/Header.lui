namespace Lucent.IssueBrowser;

style HeaderStyle {
    Axis: LayoutAxis.Column;
    Padding: Insets.Uniform(16);
    Spacing: 12;
    MainShrink: 0;
}

style HeaderTitleStyle {
    MainGrow: 1;
}

style HeaderContentStyle {
    Axis: LayoutAxis.Row;
    Spacing: 12;
    CrossAlignment: LayoutAlignment.Center;
    Wrap: true;
}

style DensityButtonStyle {
    MaxWidth: 240;
    MainShrink: 0;
}

public component Header(IssueBrowserState browser, IssueBrowserViewState view) {
    <Layout style={HeaderStyle}>
        <Layout style={HeaderContentStyle}>
            <Text style={PresentationStyles.Title.With(HeaderTitleStyle)} name="issue-browser.title">Issues</Text>
            <Button onInvoke={browser.ToggleDensity} style={DensityButtonStyle} name="issue-browser.density">{browser.Density == IssueDensity.Comfortable ? "Density: comfortable" : "Density: compact"}</Button>
        </Layout>
        <Text style={PresentationStyles.Secondary}>Lucent reference workspace · local fixtures</Text>
        <FilterBar browser={browser} view={view} name="issue-browser.filters" />
    </Layout>
}
