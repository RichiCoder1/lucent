namespace Lucent.IssueBrowser;
style HeaderStyle {
    Background: HeaderSurface;
}

style HeaderTitleStyle {
    Height: 24;
}

style DensityButtonStyle {
    Width: 250;
}

public component Header(IssueBrowserState browser) {
    <Column style={HeaderStyle with { Height: browser.Density == IssueDensity.Comfortable ? 84f : 68f; }}>
        <Text style={HeaderTitleStyle with { FontSize: browser.Density == IssueDensity.Comfortable ? 18f : 16f; }} name="issue-browser.title">Issues</Text>
        <FilterBar browser={browser} name="issue-browser.filters" />
        <Button onInvoke={browser.ToggleDensity} style={DensityButtonStyle with { Height: browser.Density == IssueDensity.Comfortable ? 28f : 22f; }} name="issue-browser.density">Density: Comfortable/Compact</Button>
    </Column>
}
