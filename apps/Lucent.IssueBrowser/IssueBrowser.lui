namespace Lucent.IssueBrowser;

style IssueBrowserStyle {
    Axis: LayoutAxis.Column;
    MainGrow: 1;
    MainBasis: 0;
    MinWidth: 0;
    MinHeight: 0;
    Clip: true;
}

style WorkspaceStyle {
    MainGrow: 1;
    MainBasis: 0;
    MinWidth: 0;
    MinHeight: 0;
    Clip: true;
}

style IssueBrowserFirstPaneStyle(WindowBreakpoints breakpoints, IssueBrowserViewState view) {
    MainGrow: 0;
    MainShrink: 0;
    Participation: ElementParticipation.Visible;

    when (!breakpoints.IsActive(IssueBrowserBreakpoints.Wide) && !view.DetailsRoute) {
        Width: null;
        MainGrow: 1;
        MainShrink: 1;
    }

    when (!breakpoints.IsActive(IssueBrowserBreakpoints.Wide) && view.DetailsRoute) {
        Participation: ElementParticipation.Collapsed;
    }
}

style IssueBrowserSecondPaneStyle(WindowBreakpoints breakpoints, IssueBrowserViewState view) {
    MainGrow: 1;
    MainShrink: 1;
    Participation: ElementParticipation.Visible;

    when (!breakpoints.IsActive(IssueBrowserBreakpoints.Wide) && view.DetailsRoute) {
        Width: null;
        MainGrow: 1;
        MainShrink: 1;
    }

    when (!breakpoints.IsActive(IssueBrowserBreakpoints.Wide) && !view.DetailsRoute) {
        Participation: ElementParticipation.Collapsed;
    }
}

style IssueBrowserSplitterStyle(WindowBreakpoints breakpoints) {
    Participation: ElementParticipation.Visible;

    when (!breakpoints.IsActive(IssueBrowserBreakpoints.Wide)) {
        Participation: ElementParticipation.Collapsed;
    }
}

public component IssueBrowser(IssueBrowserState browser) {
    [Once] IssueBrowserViewState view = null!;

    Setup(owner) {
        view = new IssueBrowserViewState(owner, browser);
    }

    <Layout breakpoints={view.Breakpoints} style={PresentationStyles.Surface.With(IssueBrowserStyle)}>
        <Header browser={browser} view={view} name="issue-browser.header" />
        if (browser.IsLoading) {
            <Loading browser={browser} name="issue-browser.loading" />
        }
        if (browser.Error is not null) {
            <ErrorNotice message={() => browser.Error ?? ""} retry={browser.Retry} name="issue-browser.error" />
        }
        <Divider />
        <SplitPane first={[IssueList(browser, view)]} second={[IssueDetailPane(browser, view)]} state={view.Split} label="Resize issue list" style={WorkspaceStyle} splitterStyle={IssueBrowserSplitterStyle(view.Breakpoints)} firstStyle={IssueBrowserFirstPaneStyle(view.Breakpoints, view)} secondStyle={IssueBrowserSecondPaneStyle(view.Breakpoints, view)} />
    </Layout>
}
