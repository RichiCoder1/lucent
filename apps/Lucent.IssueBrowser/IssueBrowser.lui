namespace Lucent.IssueBrowser;

style IssueBrowserStyle {
    MainGrow: 1;
    MainBasis: 0;
    MinWidth: 0;
    MinHeight: 0;
    Clip: true;
}

style WorkspaceStyle {
    MainGrow: 1;
    MainBasis: 0;
    MinWidth: 0;
    MinHeight: 0;
    Clip: true;
}

public component IssueBrowser(IssueBrowserState browser) {
    [Once] IssueBrowserViewState view = null!;

    Setup(owner) {
        view = new IssueBrowserViewState(owner, browser);
    }

    <ResponsiveContainer constraints={view.Constraints} style={PresentationStyles.Surface.With(IssueBrowserStyle)}>
        <Column style={IssueBrowserStyle}>
            <Header browser={browser} view={view} name="issue-browser.header" />
            if (browser.IsLoading) {
                <Loading browser={browser} name="issue-browser.loading" />
            }
            if (browser.Error is not null) {
                <Error browser={browser} name="issue-browser.error" />
            }
            <Divider />
            if (view.IsWide) {
                <SplitPane first={[IssueList(browser, view)]} second={[IssueDetailPane(browser, view)]} state={view.Split} label="Resize issue list" style={WorkspaceStyle} />
            } else {
                <Column style={WorkspaceStyle}>
                    if (view.ShowDetails) {
                        <Column style={IssueBrowserStyle}>
                            <Button onInvoke={view.BackToList} name="issue-browser.back">Back to issues</Button>
                            <IssueDetailPane browser={browser} view={view} />
                        </Column>
                    } else {
                        <IssueList browser={browser} view={view} />
                    }
                </Column>
            }
        </Column>
    </ResponsiveContainer>
}
