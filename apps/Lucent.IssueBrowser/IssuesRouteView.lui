namespace Lucent.IssueBrowser;

style DetailEmptyStyle {
    Axis: LayoutAxis.Column;
    Spacing: 12;
}

public component IssuesRouteView() {
    context RouteContext<IssuesRoute> route;

    <Layout style={DetailEmptyStyle}>
        <Text style={PresentationStyles.Title}>Open an issue</Text>
        <Text style={PresentationStyles.Body with { TextWrap: TextWrap.WordWithGraphemeFallback; }}>
            Choose an issue to read its details and explore the available actions.
        </Text>
        <Text style={PresentationStyles.Secondary}>
            Local fixtures · no GitHub account required
        </Text>
    </Layout>
}
