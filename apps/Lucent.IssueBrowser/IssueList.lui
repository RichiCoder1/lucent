namespace Lucent.IssueBrowser;

style IssueListStyle {
    MainGrow: 1;
    MinWidth: 0;
    MinHeight: 0;
    Clip: true;
    Padding: Insets.Uniform(12);
    Spacing: 12;
}

style IssueListViewportStyle {
    MainGrow: 1;
    MinWidth: 0;
    MinHeight: 0;
    Clip: true;
    Visibility: ScrollBarVisibility.Auto;
}

public component IssueList(IssueBrowserState browser, IssueBrowserViewState view) {
    <Column style={IssueListStyle}>
        <Text style={PresentationStyles.Secondary} name="issue-browser.result-count">{view.ResultSummary}</Text>
        if (!browser.IsLoading && browser.VisibleIssues.Count == 0) {
            <Column style={Style.Empty with { Spacing: 12; Padding: Insets.Uniform(16); }}>
                <Text style={PresentationStyles.Title}>No matching issues</Text>
                <Text style={PresentationStyles.Body}>Try a different search or clear your filters.</Text>
            </Column>
        }
        <VirtualizedList source={() => browser.VisibleIssues} key={issue => issue.Number} row={issue => IssueRow(browser, () => issue.Value, view).Named("issue-browser.issue-row")} rowHeight={() => view.RowHeight} viewport={view.ListViewport} label="Issues" style={IssueListViewportStyle} name="issue-browser.scroll-viewport" />
    </Column>
}
