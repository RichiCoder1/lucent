namespace Lucent.IssueBrowser;

style DetailsContentStyle {
    Axis: LayoutAxis.Column;
    Spacing: 16;
    MainGrow: 1;
    MinHeight: 0;
    Clip: true;
}

style DetailsViewportStyle {
    MainGrow: 1;
    MinHeight: 0;
    Clip: true;
}

style DetailsActionsStyle {
    Axis: LayoutAxis.Row;
}

public component Details(
    IssueBrowserState browser,
    Func<BrowserIssue> issue,
    IssueBrowserViewState view
) {
    context NavigationInteraction navigation;
    readonly FocusTarget actionFocus = new(owner, "issue-details-action");

    <NavigationTarget
        interaction={navigation}
        id="issue-actions"
        label="Issue actions"
        focusTarget={actionFocus}
        viewport={view.DetailViewport}
    >
        <Layout style={DetailsContentStyle}>
            <Text style={PresentationStyles.Caption} content={() => "ISSUE #" + issue().Number} />
            <Text
                style={PresentationStyles.Title with {
                    TextWrap: TextWrap.WordWithGraphemeFallback;
                }}
                content={() => issue().Title}
                name="issue-browser.details-title"
            />
            <Status
                style={PresentationStyles.Secondary}
                content={
                    () => issue().Status + " · " + issue().Assignee + " · updated "
                        + FormatUpdated(issue())
                        + (browser.MutationMessage(issue().Number) is { } message
                            ? " · " + message
                            : "")
                }
                name="issue-browser.details-status"
            />
            <Text
                style={PresentationStyles.Caption with {
                    TextWrap: TextWrap.WordWithGraphemeFallback;
                }}
                content={() => issue().Labels}
            />
            <Divider />
            <ScrollViewport
                viewport={view.DetailViewport}
                label="Issue details"
                style={DetailsViewportStyle}
            >
                <Text
                    style={PresentationStyles.Body with {
                        TextWrap: TextWrap.WordWithGraphemeFallback;
                    }}
                    content={() => issue().Body}
                    name="issue-browser.details-body"
                />
            </ScrollViewport>
            <Layout style={DetailsActionsStyle}>
                <Button
                    leadingIcon={
                        () => issue().Status == "open"
                            ? Lucent.Icons.Lucide.LucideIcons.CircleCheck
                            : Lucent.Icons.Lucide.LucideIcons.CircleDot
                    }
                    onInvoke={() => browser.ToggleIssueStatus(issue().Number)}
                    focusTarget={actionFocus}
                    name="issue-browser.status-action"
                >
                    {issue().Status == "open" ? "Close issue" : "Reopen issue"}
                </Button>
                if (browser.CanRetry(issue().Number)) {
                    <Button
                        leadingIcon={Lucent.Icons.Lucide.LucideIcons.RefreshCw}
                        onInvoke={() => browser.RetryIssue(issue().Number)}
                        name="issue-browser.details-retry"
                    >
                        Retry status change
                    </Button>
                }
            </Layout>
        </Layout>
    </NavigationTarget>
}
