namespace Lucent.IssueBrowser;
style ErrorStatusStyle {
    Axis: LayoutAxis.Column;
    TextWrap: TextWrap.WordWithGraphemeFallback;
}

style ErrorPanelStyle {
    Axis: LayoutAxis.Column;
    Padding: Insets.Symmetric(16, 8);
    Spacing: 8;
}

style ErrorActionsStyle {
    Axis: LayoutAxis.Row;
}

public component Error(IssueBrowserState browser) {
    <Layout style={ErrorPanelStyle}>
        <Status content={() => browser.Error ?? ""} style={PresentationStyles.Secondary.With(ErrorStatusStyle)} />
        <Layout style={ErrorActionsStyle}>
            <Button onInvoke={browser.Retry} name="issue-browser.retry">Retry</Button>
        </Layout>
    </Layout>
}
