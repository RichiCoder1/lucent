namespace Lucent.IssueBrowser;

public component IssueRowMenu(IssueBrowserState browser, Func<BrowserIssue> issue, IssueBrowserViewState? view = null) {
    <Menu>
        <MenuItem onInvoke={() => OpenIssue(browser, issue().Number, view)}>Open issue</MenuItem>
        <MenuSeparator />
        <MenuItem onInvoke={() => browser.ToggleIssueStatus(issue().Number)}>Toggle status</MenuItem>
        <MenuSubmenu menu={() => IssueStatusMenu(browser, issue)}>Set status</MenuSubmenu>
    </Menu>
}
