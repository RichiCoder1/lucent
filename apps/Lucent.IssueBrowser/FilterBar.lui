namespace Lucent.IssueBrowser;

style FilterBarStyle(WindowBreakpoints breakpoints) {
    Axis: LayoutAxis.Column;
    Spacing: 8;
    MainShrink: 0;

    when (breakpoints.IsActive(IssueBrowserBreakpoints.Wide)) {
        Axis: LayoutAxis.Row;
        Spacing: 12;
        CrossAlignment: LayoutAlignment.End;
    }
}

style FilterSearchColumnStyle(WindowBreakpoints breakpoints) {
    MainGrow: 1;
    MainShrink: 1;
    MinWidth: 0;
    Spacing: 6;

    when (breakpoints.IsActive(IssueBrowserBreakpoints.Wide)) {
        Width: 240;
    }
}

style FilterStatusColumnStyle(WindowBreakpoints breakpoints) {
    Width: 120;
    Spacing: 6;
    MainShrink: 0;

    when (!breakpoints.IsActive(IssueBrowserBreakpoints.Wide)) {
        MainGrow: 1;
    }
}

style FilterAssigneeColumnStyle(WindowBreakpoints breakpoints) {
    Width: 160;
    Spacing: 6;
    MainShrink: 0;

    when (!breakpoints.IsActive(IssueBrowserBreakpoints.Wide)) {
        MainGrow: 1;
    }
}

style FilterSecondaryStyle(WindowBreakpoints breakpoints) {
    Axis: LayoutAxis.Row;
    Spacing: 8;
    MainShrink: 0;

    when (breakpoints.IsActive(IssueBrowserBreakpoints.Wide)) {
        Spacing: 12;
    }
}

public component FilterBar(IssueBrowserState browser, IssueBrowserViewState view, Style? style = null) {
    <Layout style={FilterBarStyle(view.Breakpoints).With(style)}>
        <Layout style={FilterSearchColumnStyle(view.Breakpoints)}>
            <Text style={PresentationStyles.Caption}>Search issues</Text>
            <TextField session={view.SearchEditor} name="issue-browser.search" onChange={browser.SetSearch} label="Search issues" />
        </Layout>
        <Layout style={FilterSecondaryStyle(view.Breakpoints)}>
            <Layout style={FilterStatusColumnStyle(view.Breakpoints)}>
                <Text style={PresentationStyles.Caption}>Status</Text>
                <TextField session={view.StatusEditor} name="issue-browser.status" onChange={browser.SetStatus} label="Status: all, open, closed" />
            </Layout>
            <Layout style={FilterAssigneeColumnStyle(view.Breakpoints)}>
                <Text style={PresentationStyles.Caption}>Assignee</Text>
                <TextField session={view.AssigneeEditor} name="issue-browser.assignee" onChange={browser.SetAssignee} label="Assignee: all, marta, devin, joel" />
            </Layout>
            <Button onInvoke={view.ClearFilters}>Clear filters</Button>
        </Layout>
    </Layout>
}
