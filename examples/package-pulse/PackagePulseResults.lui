namespace Lucent.Examples.PackagePulse;

using Avalonia.Controls;
using Avalonia.Layout;

component PackagePulseResults(string query, Action<string> updateQuery, IReadOnlyList<PackageInfo> items, bool pending)
{
    Fragment Render() => Border {
        Class: "app-shell";
        MaxWidth: 760;
        HorizontalAlignment: HorizontalAlignment.Center;

        StackPanel {
            Class: "content";
            Grid { ColumnDefinitions: "* Auto";
                TextBlock { Class: "title"; Text: "Package Pulse"; }
                Border { Class: "result-badge"; Grid.Column: 1; TextBlock { Text: pending ? "Updating" : "Live"; } }
            }
            TextBlock { Class: "subtitle"; Text: "Search a simulated package feed. Results stay in place while newer data loads."; }
            TextBox {
                Class: "search";
                Text: query;
                PlaceholderText: "Try avalonia, reactive, toolkit, or fail";
                TextChanged: (sender, e) => updateQuery(sender.Text ?? "");
            }
            Border {
                if (pending && items.Count > 0 && items[0].Id.StartsWith("loading", StringComparison.Ordinal)) {
                    TextBlock { Class: "status"; Text: "Loading package index…"; }
                }
            }
            Border {
                if (!pending && items.Count == 0) {
                    TextBlock { Class: "status"; Text: "No packages match this query."; }
                }
            }
            Grid { ColumnDefinitions: "* Auto";
                TextBlock { Class: "results-heading"; Text: "Results"; }
                TextBlock { Class: "result-count"; Grid.Column: 1; Text: $"{items.Count} packages"; }
            }
            Border { Class: "package-list";
                if (items.Count > 0) {
                    PackagePulseRows(items) {}
                }
            }
        }
    };
}
