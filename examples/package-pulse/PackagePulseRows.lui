namespace Lucent.Examples.PackagePulse;

using Avalonia.Controls;

component PackagePulseRows(IReadOnlyList<PackageInfo> items) => StackPanel {
    Class: "results";
    foreach (var package in items)
    keyed by package.Id {
        Border {
            Class: "package-row";
            Grid { ColumnDefinitions: "* Auto"; RowDefinitions: "Auto Auto";
                Class: "package-copy";
                TextBlock { Class: "package-name"; Text: package.Name; }
                TextBlock { Class: "package-version"; Grid.Column: 1; Text: package.Version; }
                TextBlock { Class: "package-description"; Grid.Row: 1; Text: package.Description; }
            }
        }
    }
};
