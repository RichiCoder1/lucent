namespace Lucent.Examples.PackagePulse;

using Avalonia.Controls;

component PackagePulseRows(IReadOnlyList<PackageInfo> items) => StackPanel {
    Class: "results";
    foreach (var package in items)
    keyed by package.Id {
        Border {
            Class: "package-row";
            StackPanel {
                Class: "package-copy";
                TextBlock { Class: "package-name"; Text: package.Name; }
                TextBlock { Class: "package-version"; Text: package.Version; }
                TextBlock { Class: "package-description"; Text: package.Description; }
            }
        }
    }
};
