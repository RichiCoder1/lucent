namespace Lucent.Examples.PackagePulse;


component PackagePulse()
{
    private readonly State<string> query = new("lucent");
    private readonly Computed<PackageInfo[]> packages = new(
        cancellationToken => PackageCatalog.SearchAsync(query.Value, cancellationToken),
        PackageCatalog.Placeholders);

    private void UpdateQuery(string value) => query.Update(value);
    private void RetryPackages()
    {
        UpdateQuery("lucent");
        packages.Refresh();
    }
    Fragment Render() => StackPanel {
        ContentControl {
            try (packages) {
                PackagePulseResults(query.Value, UpdateQuery, packages.Value, packages.IsPending) {}
            }
            catch (Exception error) {
                StackPanel { Class: "pulse-error-state";
                    PackagePulseResults(query.Value, UpdateQuery, packages.Value, false) {}
                    Border {
                        Class: "error-state";
                        StackPanel {
                            TextBlock { Class: "error-title"; Text: "Search failed"; }
                            TextBlock { Class: "status"; Text: error.Message; }
                            Button { Class: "retry-action"; Content: "Retry"; Click: () => RetryPackages(); }
                        }
                    }
                }
            }
        }
    };
}
