namespace Lucent.Examples.PackagePulse;

using Lucent.Examples.PackagePulse;

component MainWindow(string initialQuery = "lucent")
{
    Fragment Render()
    {
        return Window {
            Title: "Package Pulse — Lucent Async + CSS";
            Width: 820;
            Height: 760;
            MinWidth: 600;
            MinHeight: 560;
            WindowStartupLocation: Avalonia.Controls.WindowStartupLocation.CenterScreen;

            PackagePulse(initialQuery) {}
        };
    }
}
