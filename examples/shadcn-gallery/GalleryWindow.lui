namespace ShadcnGallery;

using Avalonia.Controls;

component GalleryWindow()
{
    Fragment Render() => Window {
        Title: "Shadcn control gallery";
        Width: 900;
        Height: 700;
        Grid { RowDefinitions: "Auto *";
            Border { Class: "gallery-header"; Padding: (20, 14); Height: 72;
                Grid { ColumnDefinitions: "* Auto";
                    StackPanel { Spacing: 2;
                        TextBlock { Class: "gallery-title"; Text: "Shadcn gallery"; }
                        TextBlock { Class: "gallery-subtitle"; Text: "Native Avalonia controls, composed in Lucent."; }
                    }
                    Border { Grid.Column: 1; Class: "gallery-badge"; Padding: (10, 5); VerticalAlignment: Avalonia.Layout.VerticalAlignment.Center;
                        TextBlock { Class: "gallery-badge-text"; Text: "New York · neutral"; }
                    }
                }
            }
            Grid { Grid.Row: 1; ColumnDefinitions: "190 *";
                Border { Class: "gallery-sidebar"; Grid.Column: 0; Padding: 20;
                    StackPanel { Spacing: 6;
                            TextBlock { Class: "section-label"; Text: "COMPONENTS"; }
                            Button { Class: "gallery-nav active"; HorizontalAlignment: Avalonia.Layout.HorizontalAlignment.Stretch; HorizontalContentAlignment: Avalonia.Layout.HorizontalAlignment.Left; Content: "Overview"; }
                            Button { Class: "gallery-nav"; HorizontalAlignment: Avalonia.Layout.HorizontalAlignment.Stretch; HorizontalContentAlignment: Avalonia.Layout.HorizontalAlignment.Left; Content: "Controls"; }
                            Button { Class: "gallery-nav"; HorizontalAlignment: Avalonia.Layout.HorizontalAlignment.Stretch; HorizontalContentAlignment: Avalonia.Layout.HorizontalAlignment.Left; Content: "States"; }
                            Button { Class: "gallery-nav"; HorizontalAlignment: Avalonia.Layout.HorizontalAlignment.Stretch; HorizontalContentAlignment: Avalonia.Layout.HorizontalAlignment.Left; Content: "Utilities"; }
                    }
                }
                ScrollViewer { Grid.Column: 1;
                    Border { Padding: 24;
                    StackPanel { Class: "gallery-content"; Spacing: 16;
                        StackPanel { Spacing: 4;
                            TextBlock { Class: "section-title"; Text: "Overview"; }
                            TextBlock { Class: "section-copy"; Text: "A compact executable reference for the shared Shadcn theme."; }
                        }
                        Grid { ColumnDefinitions: "* 8 * 8 *";
                            Border { Class: "token-row token-primary"; TextBlock { Class: "token-primary-text"; Text: "Primary"; } }
                            Border { Class: "token-row token-muted"; Grid.Column: 2; TextBlock { Text: "Muted"; } }
                            Border { Class: "token-row token-destructive"; Grid.Column: 4; TextBlock { Class: "token-destructive-text"; Text: "Destructive"; } }
                        }
                        Grid { ColumnDefinitions: "* 16 *";
                            Border { Class: "card gallery-card";
                                StackPanel { Spacing: 10;
                                    TextBlock { Class: "section-title"; Text: "Buttons"; }
                                    StackPanel { Orientation: Avalonia.Layout.Orientation.Horizontal; Spacing: 8;
                                        Button { Content: "Primary"; }
                                        Button { Class: "secondary"; Content: "Secondary"; }
                                        Button { Class: "outline"; Content: "Outline"; }
                                        Button { Class: "destructive"; Content: "Destructive"; }
                                    }
                                    StackPanel { Orientation: Avalonia.Layout.Orientation.Horizontal; Spacing: 8;
                                        Button { Name: "HoverEvidence"; Content: "Hover"; }
                                        Button { Name: "PressedEvidence"; Content: "Pressed"; }
                                        Button { Name: "FocusVisibleEvidence"; Content: "Focus visible"; }
                                        Button { Content: "Disabled"; IsEnabled: false; }
                                    }
                                }
                            }
                            Border { Class: "card gallery-card"; Grid.Column: 2;
                                StackPanel { Spacing: 10;
                                    TextBlock { Class: "section-title"; Text: "Fields"; }
                                    TextBox { Name: "FocusTarget"; Text: "Focused field"; }
                                    TextBox { PlaceholderText: "Empty field"; }
                                    TextBox { Text: "Disabled"; IsEnabled: false; }
                                    TextBox { Name: "InvalidField"; Text: "Invalid"; }
                                    TextBlock { Name: "ValidationText"; Class: "validation-text"; Text: "Invalid field (native validation state)"; }
                                }
                            }
                        }
                        Grid { ColumnDefinitions: "* 16 *";
                            Border { Class: "card gallery-card";
                                StackPanel { Spacing: 8;
                                    TextBlock { Class: "section-title"; Text: "Selection"; }
                                    CheckBox { Name: "CheckedEvidence"; Content: "Checked"; IsChecked: true; }
                                    CheckBox { Content: "Unchecked"; IsChecked: false; }
                                    RadioButton { Content: "Selected"; IsChecked: true; }
                                    RadioButton { Content: "Unselected"; IsChecked: false; }
                                    ComboBox { ItemsSource: new[] { "One", "Two", "Three" }; SelectedIndex: 0; }
                                    ListBox { Height: 58;
                                        ListBoxItem { Name: "SelectedUtilityEvidence"; Class: "selected:bg-muted"; Content: "Selected"; IsSelected: true; }
                                        ListBoxItem { Content: "Unselected"; }
                                    }
                                }
                            }
                            Border { Class: "card gallery-card"; Grid.Column: 2;
                                StackPanel { Spacing: 8;
                                    TextBlock { Class: "section-title"; Text: "Navigation"; }
                                    TabControl { Height: 60;
                                        TabItem { Header: "First"; }
                                        TabItem { Header: "Second"; }
                                    }
                                    Menu { ItemsSource: new[] { new MenuItem { Header = "Menu", ItemsSource = new[] { new MenuItem { Header = "Menu item" } } } }; }
                                    ToolTip { Content: "Visible tooltip treatment"; }
                                }
                            }
                        }
                        Border { Name: "UtilityCatalogEvidence"; Class: "utility-evidence m-2 m-4 p-2 p-4 bg-muted border-border border border-2 rounded rounded-lg overflow-hidden text-center-self items-center";
                            StackPanel { Class: "gap-2 gap-4";
                                TextBlock { Name: "UtilityTypographyEvidence"; Class: "text-sm text-lg font-medium font-bold italic text-left text-center text-wrap text-nowrap leading-6"; Text: "Typography: bold italic centered line-height"; }
                                Border { Name: "UtilityConflictEvidence"; Class: "p-2 p-4 w-24 w-48 h-8 h-12 bg-primary"; TextBlock { Text: "Canonical conflict: p-4 / w-48 / h-12 win"; } }
                                Button { Class: "hover:bg-primary"; Content: "Hover utility"; }
                                TextBox { Class: "focus:border-ring"; Text: "Focus utility"; }
                                Button { Class: "focus-visible:border-ring"; Content: "Focus-visible utility"; }
                                Button { Class: "disabled:opacity-50"; Content: "Disabled utility"; IsEnabled: false; }
                                CheckBox { Class: "checked:bg-primary"; Content: "Checked utility"; IsChecked: true; }
                                Button { Name: "UtilityForegroundEvidence"; Class: "text-foreground"; Content: "Templated foreground utility"; }
                                Border { Name: "UtilityOpacityEvidence"; Class: "opacity-50 opacity-100"; TextBlock { Text: "Opacity-100 wins"; } }
                                Border { Name: "UtilityHiddenEvidence"; Class: "hidden"; TextBlock { Text: "Hidden utility remains captured structurally"; } }
                            }
                        }
                    }
                    }
                }
            }
        }
    };
}
