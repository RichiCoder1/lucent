namespace Lucent.Examples.Workbench;

using Avalonia;
using Avalonia.Automation;
using Avalonia.Automation.Peers;
using Avalonia.Controls;
using Avalonia.Data;
using Avalonia.Input;
using Avalonia.Layout;
using Avalonia.Styling;
using Avalonia.VisualTree;
using AvaloniaEdit;
using System.Collections.ObjectModel;
using System;
using System.Globalization;
using System.Linq;
using System.Threading;
using System.Threading.Tasks;
using System.Windows.Input;

component WorkbenchApp(IWorkbenchDesktopHost desktopHost, CancellationToken lifetime, Action<Exception> errorReporter, WorkbenchSettings initialSettings, SettingsSaveCoordinator saveCoordinator, IProblemLoader problemLoader, DocumentSession session, WorkspaceService workspace, bool initialShowPalette = false)
{
    private readonly State<bool> showProblems = new(initialSettings.ProblemsVisible);
    private readonly State<bool> showPalette = new(initialShowPalette);
    private readonly State<string> workspaceName = new(workspace.RootPath is null ? "Lucent" : Path.GetFileName(Path.TrimEndingDirectorySeparator(workspace.RootPath)));
    private readonly State<string?> workspacePath = new(workspace.RootPath);
    private readonly State<string> documentTitle = new("Program.cs");
    private readonly State<string> lastDiagnostic = new("No diagnostics copied");
    private readonly ObservableCollection<WorkspaceNode> workspaceRoots = new(workspace.Roots.Count == 0 ? [new WorkspaceNode("root", "Lucent", new ObservableCollection<WorkspaceNode>([
        new WorkspaceNode("src", "src", new ObservableCollection<WorkspaceNode>([
            new WorkspaceNode("compiler", "Lucent.Compiler", []), new WorkspaceNode("runtime", "Lucent.Runtime", [])])),
        new WorkspaceNode("readme", "README.md", [])]))] : workspace.Roots);
    private readonly WorkspaceSelectionController workspaceSelection = new WorkspaceSelectionController(workspaceRoots);
    private readonly ObservableCollection<QuickOpenItem> quickOpenItems = new(workspace.QuickOpenItems.Count == 0 ? [
        new QuickOpenItem("quick-workbench", "WorkbenchApp.lui", "WorkbenchApp.lui"),
        new QuickOpenItem("quick-document", "DocumentPane.lui", "DocumentPane.lui")] : workspace.QuickOpenItems);
    private DocumentSession GetSession() => session;
    private readonly Computed<IReadOnlyList<ProblemItem>> loadedProblems = new(
        ct => problemLoader.LoadAsync(workspacePath.Value, ct), []);
    private Window? window = null;
    private Border? sidebar = null;
    private Border? palette = null;
    private ListBox? quickOpenList = null;
    private IInputElement? previousFocus = null;
    private bool sessionListening = false;
    private int workspaceRequest = 0;
    private int documentRequest = 0;
    private Avalonia.Media.IBrush Brush(string key)
    {
        var app = Application.Current ?? throw new InvalidOperationException("Avalonia is not initialized.");
        return app.TryFindResource(key, app.RequestedThemeVariant, out var value) &&
            value is Avalonia.Media.IBrush brush ? brush : Avalonia.Media.Brushes.Transparent;
    }

    private WorkbenchSettings currentSettings = initialSettings;
    private WorkbenchSettings Settings() => currentSettings;
    private void ApplySettings(WorkbenchSettings value)
    {
        currentSettings = value;
        showProblems.Update(value.ProblemsVisible);
        Application.Current!.RequestedThemeVariant = value.Theme switch { "Light" => ThemeVariant.Light, "Dark" => ThemeVariant.Dark, _ => ThemeVariant.Default };
        SaveSettings();
        NotifyCommandState();
    }
    private void SaveSettings()
    {
        saveCoordinator.Save(currentSettings with { RecentWorkspace = workspacePath.Value ?? currentSettings.RecentWorkspace, ProblemsVisible = showProblems.Value });
    }

    private readonly DelegateCommand openWorkspace = new DelegateCommand(OpenWorkspace, CanOpenWorkspace, errorReporter);
    private readonly DelegateCommand closeWorkspace = new DelegateCommand(CloseWorkspace, CanCloseWorkspace, errorReporter);
    private readonly DelegateCommand quickOpen = new DelegateCommand(QuickOpen, CanOpenPalette, errorReporter);
    private readonly DelegateCommand commandPalette = new DelegateCommand(ShowCommandPalette, CanOpenPalette, errorReporter);
    private readonly DelegateCommand focusSidebar = new DelegateCommand(FocusSidebar, CanFocusSidebar, errorReporter);
    private readonly DelegateCommand focusEditor = new DelegateCommand(FocusEditor, CanFocusEditor, errorReporter);
    private readonly DelegateCommand toggleProblems = new DelegateCommand(ToggleProblems, null, errorReporter);
    private readonly DelegateCommand settings = new DelegateCommand(OpenSettings, CanOpenWorkspace, errorReporter);
    private readonly DelegateCommand copyDiagnostic = new DelegateCommand(CopyDiagnostic, CanCopyDiagnostic, errorReporter);
    private readonly DelegateCommand generatedPreview = new DelegateCommand(ShowGeneratedPreview, CanOpenWorkspace, errorReporter);
    private readonly DelegateCommand copyDocument = new DelegateCommand(CopyDocument, CanCopyDocument, errorReporter);
    private readonly DelegateCommand undoDocument = new DelegateCommand(UndoDocument, CanUndoDocument, errorReporter);
    private readonly DelegateCommand redoDocument = new DelegateCommand(RedoDocument, CanRedoDocument, errorReporter);
    private readonly DelegateCommand selectAllDocument = new DelegateCommand(SelectAllDocument, CanSelectAllDocument, errorReporter);
    private readonly DelegateCommand refreshProblems = new DelegateCommand(RefreshProblems, CanOpenWorkspace, errorReporter);
    private readonly DelegateCommand retryProblems = new DelegateCommand(RefreshProblems, CanOpenWorkspace, errorReporter);
    private readonly DelegateCommand acceptQuickOpen = new DelegateCommand(OpenSelectedQuickOpen, () => showPalette.Value, errorReporter);
    private readonly DelegateCommand togglePaletteProblems = new DelegateCommand(ToggleProblemsAndClosePalette, () => showPalette.Value, errorReporter);


    private bool CanOpenWorkspace() => !lifetime.IsCancellationRequested;
    private bool CanCloseWorkspace() => CanOpenWorkspace() && workspacePath.Value is not null;
    private bool CanOpenPalette() => CanOpenWorkspace() && !showPalette.Value;
    private bool CanFocusSidebar() => sidebar is not null;
    private bool CanFocusEditor() => GetSession().Editor is not null;
    private bool CanCopyDiagnostic() => showProblems.Value;
    private bool CanCopyDocument() => GetSession().CanCopy;
    private bool CanUndoDocument() => GetSession().CanUndo;
    private bool CanRedoDocument() => GetSession().CanRedo;
    private bool CanSelectAllDocument() => GetSession().CanSelectAll;
    private void RefreshProblems() => loadedProblems.Refresh();

    private void OpenSelectedQuickOpen()
    {
        var item = quickOpenList?.SelectedItem as QuickOpenItem ?? quickOpenItems.FirstOrDefault();
        if (item is null) return;
        _ = OpenDocumentAsync(item.Path, item.DisplayName, closePalette: true);
    }

    private void NotifyCommandState()
    {
        closeWorkspace.NotifyCanExecuteChanged();
        quickOpen.NotifyCanExecuteChanged();
        commandPalette.NotifyCanExecuteChanged();
        focusSidebar.NotifyCanExecuteChanged();
        focusEditor.NotifyCanExecuteChanged();
        copyDiagnostic.NotifyCanExecuteChanged();
        copyDocument.NotifyCanExecuteChanged();
        undoDocument.NotifyCanExecuteChanged();
        redoDocument.NotifyCanExecuteChanged();
        selectAllDocument.NotifyCanExecuteChanged();
        refreshProblems.NotifyCanExecuteChanged();
        retryProblems.NotifyCanExecuteChanged();
        acceptQuickOpen.NotifyCanExecuteChanged();
        togglePaletteProblems.NotifyCanExecuteChanged();
    }

    private void OpenWorkspace() => _ = OpenWorkspaceAsync();

    private async Task OpenWorkspaceAsync()
    {
        if (!CanOpenWorkspace() || window is null) return;
        var request = ++workspaceRequest;
        try
        {
            var folders = await desktopHost.PickWorkspaceAsync(window);
            if (lifetime.IsCancellationRequested || request != workspaceRequest) return;
            var folder = folders.FirstOrDefault();
            if (folder is null) return;
            await workspace.OpenAsync(folder.Path.LocalPath, lifetime);
            if (lifetime.IsCancellationRequested || request != workspaceRequest) return;
            workspaceSelection.ReplaceRoots(workspace.Roots);
            quickOpenItems.Clear();
            foreach (var item in workspace.QuickOpenItems) quickOpenItems.Add(item);
            workspacePath.Update(_ => workspace.RootPath);
            workspaceName.Update(folder.Name);
            currentSettings = currentSettings with { RecentWorkspace = workspace.RootPath };
            if (workspace.QuickOpenItems.FirstOrDefault() is { } first)
                await OpenDocumentAsync(first.Path, first.DisplayName, closePalette: false);
            loadedProblems.Refresh();
            SaveSettings();
            closeWorkspace.NotifyCanExecuteChanged();
        }
        catch (Exception error)
        {
            if (lifetime.IsCancellationRequested) return;
            lastDiagnostic.Update(error.Message);
            loadedProblems.Refresh();
        }
    }

    private void CloseWorkspace()
    {
        if (!CanCloseWorkspace()) return;
        workspaceRequest++; documentRequest++;
        workspace.Close();
        workspacePath.Update(_ => null);
        workspaceName.Update("No workspace");
        workspaceSelection.ReplaceRoots([]);
        quickOpenItems.Clear();
        loadedProblems.Refresh();
        SaveSettings();
        closeWorkspace.NotifyCanExecuteChanged();
    }

    private void QuickOpen() => ShowCommandPalette();
    private void ShowCommandPalette()
    {
        if (!CanOpenPalette()) return;
        previousFocus = window?.FocusManager?.GetFocusedElement();
        showPalette.Update(true);
        quickOpen.NotifyCanExecuteChanged();
        commandPalette.NotifyCanExecuteChanged();
        acceptQuickOpen.NotifyCanExecuteChanged();
        togglePaletteProblems.NotifyCanExecuteChanged();
    }

    private void ClosePalette()
    {
        if (!showPalette.Value) return;
        showPalette.Update(false);
        quickOpen.NotifyCanExecuteChanged();
        commandPalette.NotifyCanExecuteChanged();
        acceptQuickOpen.NotifyCanExecuteChanged();
        togglePaletteProblems.NotifyCanExecuteChanged();
        RestoreFocus();
    }

    private void RestoreFocus()
    {
        if (previousFocus is Visual visual && visual.IsAttachedToVisualTree() &&
            previousFocus.Focusable && previousFocus.IsEffectivelyEnabled)
        {
            previousFocus.Focus();
            return;
        }

        var session = GetSession();
        if (session.Editor is not null && session.Editor.IsAttachedToVisualTree() && session.Editor.Focusable)
            session.Editor.Focus();
    }

    private void FocusSidebar() => sidebar?.GetVisualDescendants().OfType<AccessibleWorkspaceListBox>().FirstOrDefault()?.Focus();
    private void FocusEditor()
    {
        var editor = GetSession().Editor;
        if (editor is null) return;
        editor.Focus();
        editor.TextArea.Focus();
    }
    private void CopyDocument() => GetSession().Copy();
    private void UndoDocument() => GetSession().Undo();
    private void RedoDocument() => GetSession().Redo();
    private void SelectAllDocument() => GetSession().SelectAll();

    private void OpenWorkspaceNode(WorkspaceNode node)
    {
        if (node.Children.Count != 0 || node.Path is not null && Directory.Exists(node.Path)) return;
        _ = OpenDocumentAsync(node.Path ?? node.Name, node.Name, closePalette: false);
    }

    private async Task OpenDocumentAsync(string path, string title, bool closePalette, int line = 0, int column = 1)
    {
        var request = ++documentRequest;
        if (workspace.RootPath is null)
        {
            if (request != documentRequest) return;
            documentTitle.Update(title);
            GetSession().Open(path, $"// {path}\n");
            GetSession().GoToLine(line, column);
            if (closePalette) ClosePalette();
            return;
        }
        try
        {
            var text = await workspace.ReadAsync(path, lifetime);
            if (lifetime.IsCancellationRequested || request != documentRequest) return;
            documentTitle.Update(title);
            GetSession().Open(path, text);
            workspace.ActivateDocument(GetSession().Document);
            GetSession().GoToLine(line, column);
            if (path.EndsWith(".lui", StringComparison.OrdinalIgnoreCase)) loadedProblems.Refresh();
            if (closePalette) ClosePalette();
        }
        catch (Exception error) when (!lifetime.IsCancellationRequested) { lastDiagnostic.Update(error.Message); }
    }

    private void OnDocumentChanged(OpenDocument document)
    {
        workspace.UpdateDocument(document);
        if (document.Path.EndsWith(".lui", StringComparison.OrdinalIgnoreCase)) loadedProblems.Refresh();
    }

    private void OpenProblem(ProblemItem problem)
    {
        if (problem.Path is not null) _ = OpenDocumentAsync(problem.Path, problem.File, closePalette: false, line: problem.Line, column: problem.Column);
    }

    private void OpenGeneratedSource(GeneratedPreviewSnapshot snapshot, int offset)
    {
        if (workspace.TryMapGeneratedOffset(snapshot, offset, out var path, out var line, out var column))
            _ = OpenDocumentAsync(path, Path.GetFileName(path), closePalette: false, line, column);
        else lastDiagnostic.Update("No Lucent source mapping at generated caret");
    }

    private void ToggleProblems()
    {
        showProblems.Update(value => !value);
        SaveSettings();
        copyDiagnostic.NotifyCanExecuteChanged();
    }
    private void ToggleProblemsAndClosePalette()
    {
        ToggleProblems();
        ClosePalette();
    }

    private void OpenSettings() => _ = OpenSettingsAsync();

    private async Task OpenSettingsAsync()
    {
        if (!CanOpenWorkspace() || window is null) return;
        try
        {
            previousFocus = window.FocusManager?.GetFocusedElement();
            using var dialog = new SettingsDialogComponent(Settings(), ApplySettings, errorReporter);
            await desktopHost.ShowDialogAsync<bool>(window, dialog.MountRoot());
            if (!lifetime.IsCancellationRequested) RestoreFocus();
        }
        catch (Exception error)
        {
            if (lifetime.IsCancellationRequested) return;
            lastDiagnostic.Update(error.Message);
        }
    }

    private void CopyDiagnostic() => _ = CopyDiagnosticAsync();

    private async Task CopyDiagnosticAsync()
    {
        if (!CanCopyDiagnostic() || lifetime.IsCancellationRequested || window is null) return;
        try
        {
            await desktopHost.SetClipboardTextAsync(window, lastDiagnostic.Value);
            if (!lifetime.IsCancellationRequested) lastDiagnostic.Update("Diagnostic copied");
        }
        catch (Exception error)
        {
            if (lifetime.IsCancellationRequested) return;
            lastDiagnostic.Update(error.Message);
        }
    }

    private void ShowGeneratedPreview()
    {
        if (!CanOpenWorkspace() || workspace.RootPath is null || window is null) return;
        var snapshot = workspace.CaptureGeneratedPreview();
        var component = new GeneratedPreviewWindowComponent(snapshot.Source,
            offset => OpenGeneratedSource(snapshot, offset), errorReporter);
        var preview = component.MountRoot();
        EventHandler? closed = null;
        closed = (_, _) => { preview.Closed -= closed; component.Dispose(); };
        preview.Closed += closed;
        try { desktopHost.ShowOwnedWindow(window, preview); }
        catch (Exception error)
        {
            preview.Closed -= closed;
            component.Dispose();
            if (!lifetime.IsCancellationRequested) lastDiagnostic.Update(error.Message);
        }
    }

    Fragment Render() => Window {
        Title: "Lucent Workbench";
        Width: 960;
        Height: 680;
        MinWidth: 920;
        MinHeight: 600;
        Class: "workbench-window";
        Loaded: (sender, e) => { window = sender; if (!sessionListening) { GetSession().Changed += OnDocumentChanged; sessionListening = true; } };
        Unloaded: (sender, e) => { if (ReferenceEquals(window, sender)) window = null; if (sessionListening) { GetSession().Changed -= OnDocumentChanged; sessionListening = false; } GetSession().Dispose(); };
        KeyBindings: [
            new KeyBinding { Gesture = new KeyGesture(Key.O, KeyModifiers.Control), Command = openWorkspace },
            new KeyBinding { Gesture = new KeyGesture(Key.W, KeyModifiers.Control), Command = closeWorkspace },
            new KeyBinding { Gesture = new KeyGesture(Key.P, KeyModifiers.Control), Command = quickOpen },
            new KeyBinding { Gesture = new KeyGesture(Key.K, KeyModifiers.Control), Command = commandPalette },
            new KeyBinding { Gesture = new KeyGesture(Key.B, KeyModifiers.Control), Command = focusSidebar },
            new KeyBinding { Gesture = new KeyGesture(Key.E, KeyModifiers.Control), Command = focusEditor },
            new KeyBinding { Gesture = new KeyGesture(Key.T, KeyModifiers.Control), Command = toggleProblems },
            new KeyBinding { Gesture = new KeyGesture(Key.S, KeyModifiers.Control), Command = settings },
            new KeyBinding { Gesture = new KeyGesture(Key.G, KeyModifiers.Control), Command = generatedPreview },
            new KeyBinding { Gesture = new KeyGesture(Key.C, KeyModifiers.Control), Command = copyDiagnostic },
            new KeyBinding { Gesture = new KeyGesture(Key.Z, KeyModifiers.Control), Command = undoDocument },
            new KeyBinding { Gesture = new KeyGesture(Key.Y, KeyModifiers.Control), Command = redoDocument },
            new KeyBinding { Gesture = new KeyGesture(Key.A, KeyModifiers.Control), Command = selectAllDocument },
            new KeyBinding { Gesture = new KeyGesture(Key.R, KeyModifiers.Control | KeyModifiers.Shift), Command = refreshProblems },
        ];
        AutomationProperties.Name: "Lucent Workbench";
        AutomationProperties.AutomationId: "Workbench.Window";
        Grid {
            Class: "shell";
            RowDefinitions: "Auto * Auto Auto";
            Border { Class: "command-header"; Padding: (16, 8); Height: 52;
            Grid { ColumnDefinitions: "Auto Auto Auto *";
                TextBlock { Class: "app-name"; Text: "Lucent"; VerticalAlignment: VerticalAlignment.Center; }
                Border { Class: "command-divider"; Grid.Column: 1; Width: 1; Height: 24; Margin: (16, 0); VerticalAlignment: VerticalAlignment.Center; }
                TextBlock { Class: "workspace-name"; Grid.Column: 2; Text: $"Workspace: {workspaceName.Value}"; VerticalAlignment: VerticalAlignment.Center; }
                Menu {
                Class: "topbar"; Grid.Column: 3;
                Grid.Row: 0;
                HorizontalAlignment: HorizontalAlignment.Right;
                VerticalAlignment: VerticalAlignment.Center;
                MenuItem { Header: "Open workspace"; Command: openWorkspace; }
                MenuItem { Header: "Close workspace"; Command: closeWorkspace; }
                MenuItem { Header: "Quick open"; Command: quickOpen; }
                MenuItem { Header: "Command palette"; Command: commandPalette; }
                MenuItem { Header: "Settings"; Command: settings; }
                MenuItem { Header: "Copy diagnostic"; Command: copyDiagnostic; }
            }
            }
            }
            Grid {
                Class: "work-area";
                Grid.Row: 1;
                ColumnDefinitions: $"{currentSettings.SidebarWidth:0} * 280";
                Border {
                    Class: "sidebar-host";
                    Grid.Column: 0;
                    Focusable: true;
                    Loaded: (sender, e) => { sidebar = sender; focusSidebar.NotifyCanExecuteChanged(); };
                    Unloaded: (sender, e) => { if (ReferenceEquals(sidebar, sender)) sidebar = null; focusSidebar.NotifyCanExecuteChanged(); };
                    WorkspaceSidebar(workspaceName.Value, workspaceSelection, OpenWorkspaceNode, compact: false) {}
                }
                Border {
                    Class: "editor-host";
                    Grid.Column: 1;
                    DocumentPane(documentTitle.Value, GetSession(), focusCommand: focusEditor, copyCommand: copyDocument, undoCommand: undoDocument, redoCommand: redoDocument, selectAllCommand: selectAllDocument) {}
                }
                ContentControl {
                    Class: "problems-host";
                    Grid.Column: 2;
                    IsVisible: showProblems.Value;
                    try (loadedProblems) {
                        ProblemsPane(loadedProblems.Value, loadedProblems.IsPending, copyCommand: copyDiagnostic, navigate: OpenProblem) {}
                    }
                    loading {
                        Border { Class: "problems-loading";
                            TextBlock { Class: "loading-state"; Text: "Loading problems…"; AutomationProperties.Name: "Loading problems"; }
                        }
                    }
                    catch (Exception error) {
                        StackPanel { Class: "problem-error";
                            TextBlock { Class: "error-title"; Text: "Problems unavailable"; AutomationProperties.Name: "Problem loading error"; }
                            TextBlock { Class: "error-message"; Text: error.Message; }
                            Button {
                                Content: "Retry problems";
                                Focusable: true;
                                Command: retryProblems;
                                KeyBindings: [new KeyBinding { Gesture = new KeyGesture(Key.Space), Command = retryProblems }];
                            }
                        }
                    }
                }
            }
            TextBlock { Class: "problems-hidden"; Grid.Row: 2; IsVisible: !showProblems.Value; Text: "Problems hidden"; }
            Grid { Class: "status-strip"; Grid.Row: 3; ColumnDefinitions: "* Auto";
                TextBlock { Class: "status-line"; Text: lastDiagnostic.Value; AutomationProperties.Name: "Diagnostic status"; }
                StackPanel { Grid.Column: 1; Orientation: Avalonia.Layout.Orientation.Horizontal; Spacing: 6;
                    Button { Class: "ghost"; Content: "Toggle problems"; Command: toggleProblems; }
                    Button { Class: "ghost"; Content: "Generated preview"; Command: generatedPreview; }
                }
            }
            Border {
                Grid.Row: 1;
                Grid.ColumnSpan: 3;
                HorizontalAlignment: HorizontalAlignment.Center;
                VerticalAlignment: VerticalAlignment.Top;
                if (showPalette.Value) {
                    Border { Class: "command-palette";
                    Width: 420;
                    Padding: 16;
                    CornerRadius: 8;
                    BorderThickness: 1;
                    Background: Brush("Shadcn.Popover");
                    BorderBrush: Brush("Shadcn.Border");
                    Margin: (0, 48, 0, 0);
                    Focusable: true;
                    KeyboardNavigation.TabNavigation: KeyboardNavigationMode.Cycle;
                    AutomationProperties.Name: "Command palette";
                    AutomationProperties.AutomationId: "CommandPalette.Dialog";
                    AutomationProperties.ControlTypeOverride: AutomationControlType.Window;
                    Loaded: (sender, e) => palette = sender;
                    Unloaded: (sender, e) => { if (ReferenceEquals(palette, sender)) palette = null; };
                    KeyDown: (sender, e) => {
                        if (e.Key == Key.Escape) { e.Handled = true; ClosePalette(); }
                        else if (e.Key == Key.Enter) { e.Handled = true; OpenSelectedQuickOpen(); }
                        else if (e.Key == Key.Tab) { e.Handled = true; quickOpenList?.Focus(); }
                    };
                    StackPanel { Spacing: 10;
                        StackPanel { Spacing: 2;
                            TextBlock { Class: "palette-title"; Text: "Command palette"; }
                            TextBlock { Class: "palette-subtitle"; Text: "Open a file or run a workspace command."; }
                        }
                        ListBox {
                            Class: "palette-results";
                            Height: 160;
                            Focusable: true;
                            ItemsSource: quickOpenItems;
                            DisplayMemberBinding: new Binding("DisplayName");
                            Loaded: (sender, e) => { quickOpenList = sender; sender.Focus(); };
                            Unloaded: (sender, e) => { if (ReferenceEquals(quickOpenList, sender)) quickOpenList = null; };
                            KeyDown: (sender, e) => {
                                if (e.Key == Key.Down) {
                                    sender.SelectedIndex = Math.Min(sender.Items.Count - 1, sender.SelectedIndex + 1);
                                    e.Handled = true;
                                }
                                else if (e.Key == Key.Up) {
                                    sender.SelectedIndex = Math.Max(0, sender.SelectedIndex - 1);
                                    e.Handled = true;
                                }
                                else if (e.Key == Key.Enter) { e.Handled = true; OpenSelectedQuickOpen(); }
                            };
                            KeyBindings: [new KeyBinding { Gesture = new KeyGesture(Key.Enter), Command = acceptQuickOpen }];
                        }
                        StackPanel { Class: "palette-actions"; Orientation: Avalonia.Layout.Orientation.Horizontal; Spacing: 6;
                            Button { Class: "outline"; Content: "Open workspace"; Command: openWorkspace; }
                            Button {
                                Class: "outline";
                                Content: "Toggle problems";
                                Click: () => ToggleProblemsAndClosePalette();
                                KeyBindings: [new KeyBinding { Gesture = new KeyGesture(Key.Space), Command = togglePaletteProblems }];
                                KeyDown: (sender, e) => {
                                    if (e.Key is Key.Space or Key.Enter) {
                                        e.Handled = true;
                                        ToggleProblemsAndClosePalette();
                                    }
                                };
                            }
                            Button { Class: "ghost"; Content: "Close palette"; Click: () => ClosePalette(); }
                        }
                    }
                    }
                }
            }
        }
    };
}
