namespace Lucent.Examples.Workbench;

using AvaloniaEdit;
using System.Windows.Input;
using Avalonia.Automation;
using Avalonia.Controls;
using Avalonia.Layout;

component DocumentPane(string title, DocumentSession session, ICommand focusCommand, ICommand copyCommand, ICommand undoCommand, ICommand redoCommand, ICommand selectAllCommand, string language = "C#")
{
    Fragment Render() => Border {
        Class: "editor-pane";
        Grid {
            Class: "editor-content";
            RowDefinitions: "Auto *";
            Border { Class: "document-header-frame"; Grid.Row: 0; Padding: (12, 8); Height: 48;
            Grid { Class: "document-header";
                ColumnDefinitions: "* Auto";
                StackPanel { Orientation: Orientation.Horizontal; Spacing: 8; VerticalAlignment: VerticalAlignment.Center;
                    TextBlock { Class: "document-title"; Text: title; AutomationProperties.Name: "Document title"; VerticalAlignment: VerticalAlignment.Center; }
                    Border { Class: "language-badge"; Padding: (6, 2);
                        TextBlock { Class: "document-language"; Text: language; }
                    }
                }
                Button { Class: "editor-action"; Grid.Column: 1; Content: "Focus editor"; Command: focusCommand; }
            }
            }
            AccessibleTextEditor {
                Class: "source-editor";
                Grid.Row: 1;
                HorizontalAlignment: HorizontalAlignment.Stretch;
                VerticalAlignment: VerticalAlignment.Stretch;
                Text: "";
                ShowLineNumbers: true;
                Focusable: true;
                AutomationProperties.Name: "Editor";
                AutomationProperties.AutomationId: "Document.Editor";
                Loaded: (sender, e) => session.Attach(sender);
                Unloaded: (sender, e) => session.Detach(sender);
            }
        }
    };
}
