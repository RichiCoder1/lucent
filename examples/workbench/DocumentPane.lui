namespace Lucent.Examples.Workbench;

using AvaloniaEdit;
using System.Windows.Input;
using Avalonia.Automation;
using Avalonia.Controls;
using Avalonia.Layout;

component DocumentPane(string title, DocumentSession session, ICommand focusCommand, ICommand copyCommand, ICommand undoCommand, ICommand redoCommand, ICommand selectAllCommand, string language = "C#")
{
    slot toolbar;
    private readonly State<int> edits = new(0);
    private void Increment() => edits.Update(value => value + 1);

    Fragment Render() => Border {
        Class: "editor-pane";
        Grid {
            Class: "editor-content";
            RowDefinitions: [
                new RowDefinition(GridLength.Auto),
                new RowDefinition(GridLength.Auto),
                new RowDefinition(GridLength.Auto),
                new RowDefinition(new GridLength(1, GridUnitType.Star)),
                new RowDefinition(GridLength.Auto)
            ];
            Grid {
                Class: "document-header";
                Grid.Row: 0;
                ColumnDefinitions: [
                    new ColumnDefinition(new GridLength(1, GridUnitType.Star)),
                    new ColumnDefinition(GridLength.Auto)
                ];
                StackPanel {
                    TextBlock { Class: "document-title"; Text: title; AutomationProperties.Name: "Document title"; }
                    TextBlock { Class: "document-language"; Text: language; }
                }
                TextBlock { Class: "document-edits"; Grid.Column: 1; Text: $"Edits: {edits.Value}"; }
            }
            StackPanel {
                Class: "editor-actions";
                Grid.Row: 1;
                Orientation: Avalonia.Layout.Orientation.Horizontal;
                Button { Class: "editor-action"; Content: "Increment edits"; Click: () => Increment(); }
                Button { Class: "editor-action"; Content: "Focus editor"; Command: focusCommand; }
            }
            StackPanel {
                Class: "editor-actions secondary";
                Grid.Row: 2;
                Orientation: Avalonia.Layout.Orientation.Horizontal;
                Button { Content: "Copy"; Command: copyCommand; }
                Button { Content: "Undo"; Command: undoCommand; }
                Button { Content: "Redo"; Command: redoCommand; }
                Button { Content: "Select all"; Command: selectAllCommand; }
            }
            AccessibleTextEditor {
                Class: "source-editor";
                Grid.Row: 3;
                HorizontalAlignment: HorizontalAlignment.Stretch;
                VerticalAlignment: VerticalAlignment.Stretch;
                Text: "";
                ShowLineNumbers: true;
                Focusable: true;
                AutomationProperties.Name: "Editor";
                AutomationProperties.AutomationId: "Document.Editor";
                Loaded: (sender, e) => session.Attach(sender);
                Unloaded: (sender, e) => session.Detach(sender);
            }
            StackPanel { Class: "document-toolbar"; Grid.Row: 4; Orientation: Orientation.Horizontal; yield children; yield toolbar; }
        }
    };
}
