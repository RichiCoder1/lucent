namespace Lucent.Examples.Workbench;

using Avalonia.Controls;

component GeneratedPreviewWindow(string source, Action<int> navigate, Action<Exception> errorReporter) => Window {
    Title: "Generated C# preview";
    Width: 720;
    Height: 480;
    Loaded: (sender, e) => sender.Title = "Generated C# preview";
    GeneratedPreviewPane(source, navigate) {}
};
