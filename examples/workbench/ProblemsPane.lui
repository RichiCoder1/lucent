namespace Lucent.Examples.Workbench;

using Avalonia.Controls;
using Avalonia.Controls.Templates;
using Avalonia;
using System.Windows.Input;
using Avalonia.Automation;

component ProblemsPane(IReadOnlyList<ProblemItem> items, bool loading, ICommand copyCommand) => Border {
    Class: "problems-pane";
    Grid {
        RowDefinitions: [
            new (GridLength.Auto),
            new (GridLength.Auto),
            new (new GridLength(1, GridUnitType.Star)),
            new (GridLength.Auto)
        ];
        TextBlock { Class: "pane-title"; Grid.Row: 0; Text: $"{items.Count} problems"; AutomationProperties.Name: "Problems"; }
        ContentControl {
            Grid.Row: 1;
            if (loading) {
                TextBlock { Class: "loading-state"; Text: "Loading problems"; AutomationProperties.Name: "Loading problems"; }
            }
        }
        ListBox {
            Class: "problems-list";
            Grid.Row: 2;
            Focusable: true;
            AutomationProperties.Name: "Problems";
            AutomationProperties.AutomationId: "Problems.List";
            ItemsSource: items;
            ItemTemplate: new FuncDataTemplate<ProblemItem>((item, _) => new TextBlock {
                Text = $"{item.File}:{item.Line} {item.Message}",
            }, true);
            KeyDown: (sender, e) => {
                if (e.Key == Avalonia.Input.Key.Down) {
                    sender.SelectedIndex = Math.Min(sender.Items.Count - 1, sender.SelectedIndex + 1);
                    e.Handled = true;
                }
                else if (e.Key == Avalonia.Input.Key.Up) {
                    sender.SelectedIndex = Math.Max(0, sender.SelectedIndex - 1);
                    e.Handled = true;
                }
            };
        }
        Button { Class: "pane-action"; Grid.Row: 3; Content: "Copy diagnostic"; Command: copyCommand; }
    }
};
