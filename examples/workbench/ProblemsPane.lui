namespace Lucent.Examples.Workbench;

using Avalonia.Controls;
using Avalonia;
using System.Windows.Input;
using Avalonia.Automation;

component ProblemsPane(IReadOnlyList<ProblemItem> items, bool loading, ICommand copyCommand, Action<ProblemItem> navigate) => Border {
    Class: "problems-pane";
    Grid {
        RowDefinitions: "Auto Auto *";
        Border { Class: "pane-header"; Grid.Row: 0; Padding: (12, 8); Height: 44;
        Grid { ColumnDefinitions: "* Auto";
            TextBlock { Class: "pane-title"; Text: $"{items.Count} problems"; AutomationProperties.Name: "Problems"; VerticalAlignment: Avalonia.Layout.VerticalAlignment.Center; }
            Border { Class: "count-badge"; Grid.Column: 1; Padding: (6, 2); VerticalAlignment: Avalonia.Layout.VerticalAlignment.Center;
                TextBlock { Text: items.Count.ToString(); }
            }
        }
        }
        ContentControl {
            Grid.Row: 1;
            if (loading) {
                TextBlock { Class: "loading-state"; Text: "Loading problems"; AutomationProperties.Name: "Loading problems"; }
            }
        }
        ListBox {
            Class: "problems-list";
            Grid.Row: 2;
            Focusable: true;
            AutomationProperties.Name: "Problems";
            AutomationProperties.AutomationId: "Problems.List";
            ItemsSource: items;
            SelectionChanged: (sender, e) => { if (sender.SelectedItem is ProblemItem item) navigate(item); };
            template ItemTemplate(ProblemItem item) {
                TextBlock { Text: $"{item.File}:{item.Line}:{item.Column} {item.Message}"; }
            }
            KeyDown: (sender, e) => {
                if (e.Key == Avalonia.Input.Key.Down) {
                    sender.SelectedIndex = Math.Min(sender.Items.Count - 1, sender.SelectedIndex + 1);
                    e.Handled = true;
                }
                else if (e.Key == Avalonia.Input.Key.Up) {
                    sender.SelectedIndex = Math.Max(0, sender.SelectedIndex - 1);
                    e.Handled = true;
                }
            };
        }
    }
};
