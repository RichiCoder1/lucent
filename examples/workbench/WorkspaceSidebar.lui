namespace Lucent.Examples.Workbench;

using System.Windows.Input;
using Avalonia.Automation;

component WorkspaceSidebar(string workspace, ICommand focusCommand, bool compact = false) => Border {
    Padding: new Avalonia.Thickness(compact ? 4 : 12);
    AutomationProperties.Name: "Workspace sidebar";
    StackPanel {
        TextBlock { Text: $"Workspace: {workspace}"; }
        Button { Content: "Focus sidebar"; Command: focusCommand; }
    }
};
