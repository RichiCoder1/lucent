namespace Lucent.Examples.Workbench;

using Avalonia;
using Avalonia.Controls;
using System.Windows.Input;
using Avalonia.Automation;

component WorkspaceSidebar(string workspace, WorkspaceSelectionController selection, Action<WorkspaceNode> openNode, ICommand focusCommand, bool compact = false) => Border {
    Class: "workspace-sidebar";
    Padding: new Avalonia.Thickness(compact ? 4 : 12);
    AutomationProperties.Name: "Workspace sidebar";
    AutomationProperties.AutomationId: "Workspace.Sidebar";
    Grid {
        RowDefinitions: "Auto Auto *";
        TextBlock { Class: "pane-title"; Grid.Row: 0; Text: $"Workspace: {workspace}"; }
        Button { Class: "pane-action"; Grid.Row: 1; Content: "Focus sidebar"; Command: focusCommand; }
        AccessibleWorkspaceListBox {
            Class: "workspace-tree";
            Grid.Row: 2;
            Focusable: true;
            AutomationProperties.Name: "Workspace";
            AutomationProperties.AutomationId: "Workspace.Tree";
            ItemsSource: selection.VisibleRows;
            template ItemTemplate(WorkspaceRow row) {
                Border {
                    Padding: new Thickness(row.Depth * 16, 2, 2, 2);
            TextBlock { Text: binding(row.Node.Name); }
                }
            }
            Loaded: (sender, e) => selection.Attach(sender);
            Unloaded: (sender, e) => selection.Detach(sender);
            SelectionChanged: (sender, e) => { if (sender.SelectedItem is WorkspaceRow row) openNode(row.Node); };
            KeyDown: (sender, e) => {
                if (e.Key == Avalonia.Input.Key.Down) {
                    sender.SelectedIndex = Math.Min(sender.Items.Count - 1, sender.SelectedIndex + 1);
                    e.Handled = true;
                }
                else if (e.Key == Avalonia.Input.Key.Up) {
                    sender.SelectedIndex = Math.Max(0, sender.SelectedIndex - 1);
                    e.Handled = true;
                }
            };
        }
    }
};
