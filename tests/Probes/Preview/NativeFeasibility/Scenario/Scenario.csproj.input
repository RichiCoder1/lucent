<Project Sdk="Microsoft.NET.Sdk;Lucent.Lui.Sdk/__LUCENT_VERSION__">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PreviewFeasibility</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lucent.Core" Version="[__LUCENT_VERSION__]" />
    <PackageReference Include="Lucent.Icons.Lucide" Version="[__LUCENT_VERSION__]" />
    <LucentAsset Include="Artwork/mark.svg" Path="mark.svg" />
  </ItemGroup>
</Project>
