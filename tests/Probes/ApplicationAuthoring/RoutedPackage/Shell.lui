namespace RoutedPackageFixture;
using Lucent.Core;

public component Shell() {
    context RouteContext<ShellRoute> route;
    context NavigationSession navigation;

    Setup(owner) {
        Acceptance.Navigation = navigation;
        Acceptance.Require(route.Definition.Id.Value == "shell", "Shell context was not supplied.");
        Acceptance.ShellMounts++;
        owner.OnDispose(() => Acceptance.ShellDisposals++);
    }

    <Column>
        <Text>routed shell</Text>
        <RouterOutlet />
    </Column>
}
