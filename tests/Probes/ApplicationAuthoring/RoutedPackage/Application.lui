namespace RoutedPackageFixture;
using System;
using Lucent.Core;

public component Application() {
    [Owned]
    readonly RouteOutletHandle outlet = new();

    Setup(owner) {
        Acceptance.Outlet = outlet;
        Acceptance.Roots.Add(this);
    }

    <Router routes={Routes.Bundle} initial="/">
        <RouterOutlet handle={outlet} />
    </Router>
}
