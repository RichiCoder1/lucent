<Project Sdk="Microsoft.NET.Sdk;Lucent.Lui.Sdk/__VERSION__">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <LucentLuiNamedComponents>true</LucentLuiNamedComponents>
    <PreparedNondeterministic>false</PreparedNondeterministic>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lucent.Core" Version="[__VERSION__]" />
    <Analyzer Include="__FOREIGN_ANALYZER__" />
    <CompilerVisibleProperty Include="PreparedNondeterministic" />
    <AdditionalFiles Include="Observed.input" />
  </ItemGroup>
</Project>
