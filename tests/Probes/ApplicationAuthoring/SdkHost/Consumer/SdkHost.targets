<Project>
  <Target
    Name="PrepareProbeGeneratorOutputs"
    BeforeTargets="CoreCompile"
    Condition="'$(ProbeSkipPrepare)' != 'true'"
  >
    <Delete Files="$(TargetPath);@(IntermediateAssembly);$(IntermediateOutputPath)ref\$(TargetFileName);$(IntermediateOutputPath)refint\$(TargetFileName)" />
    <Error
      Condition="!Exists('$(ProbeDotNetHost)')"
      Text="Probe dotnet host was not supplied: $(ProbeDotNetHost)"
    />
    <Error
      Condition="!Exists('$(ProbeHostPath)')"
      Text="Probe host was not built: $(ProbeHostPath)"
    />
    <Error
      Condition="!Exists('$(ProbeGeneratorPath)')"
      Text="Probe generators were not built: $(ProbeGeneratorPath)"
    />
    <PropertyGroup>
      <_ProbePreparationRoot>$(IntermediateOutputPath)probe-preparation</_ProbePreparationRoot>
      <_ProbeManifest>$(_ProbePreparationRoot)\manifest.json</_ProbeManifest>
      <_ProbeBindingRoot>$(_ProbePreparationRoot)\binding</_ProbeBindingRoot>
      <_ProbeBaseIntermediateMarker>$(BaseIntermediateOutputPath).probe-root</_ProbeBaseIntermediateMarker>
    </PropertyGroup>
    <RemoveDir Directories="$(_ProbePreparationRoot);$(CompilerGeneratedFilesOutputPath)" />
    <MakeDir Directories="$(_ProbePreparationRoot);$(_ProbeBindingRoot);$(CompilerGeneratedFilesOutputPath)" />
    <Exec Command="&quot;$(ProbeDotNetHost)&quot; &quot;$(ProbeHostPath)&quot; prepare &quot;$(MSBuildProjectFullPath)&quot; &quot;$(_ProbeManifest)&quot; &quot;$(_ProbeBindingRoot)&quot; &quot;$(Configuration)&quot; &quot;$(TargetFramework)&quot; &quot;$(ProbeMismatchKind)&quot; &quot;$(ProbeGeneratorPath)&quot; &quot;$(ProbeModelPath)&quot; &quot;$(_ProbeBaseIntermediateMarker)&quot;" />
    <ItemGroup>
      <AdditionalFiles Include="$(_ProbeBindingRoot)\*.binding.g.cs" ProbeBinding="true" />
    </ItemGroup>
  </Target>

  <Target
    Name="CompareProbeGeneratorOutputs"
    AfterTargets="CoreCompile"
    Condition="'$(ProbeSkipPrepare)' != 'true'"
  >
    <Exec Command="&quot;$(ProbeDotNetHost)&quot; &quot;$(ProbeHostPath)&quot; compare &quot;$(_ProbeManifest)&quot; &quot;$(CompilerGeneratedFilesOutputPath)&quot;" />
    <OnError ExecuteTargets="RemoveMismatchedProbeAssembly" />
  </Target>

  <Target Name="RemoveMismatchedProbeAssembly">
    <Delete Files="$(TargetPath);@(IntermediateAssembly);$(IntermediateOutputPath)ref\$(TargetFileName);$(IntermediateOutputPath)refint\$(TargetFileName)" />
  </Target>
</Project>
