namespace AuthoringConsumer;
using System;
using Lucent.Core;
using static AuthoringGate.ProofLibrary;
internal component Consumer(Func<string> label) {
    <Provide value={new AuthoringGate.ProofLibrary.ProbeContext("package-context")}>
        <AuthoringGate.Components.GeneratedProbe label={label} />
    </Provide>
}
