namespace Demo;

component ConditionalSnapshot()
{
    private readonly State<bool> visible = new(true);
    private readonly State<string> title = new("Latest");

    Fragment Render()
    {
        return ContentControl {
            if (visible.Value) {
                Border {
                    Child: new TextBlock();
                    Tag: title.Value;
                }
            } else {
                TextBlock { Text: "Hidden"; }
            }
        };
    }
}
