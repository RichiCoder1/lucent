namespace Lucent.Platform.Windows.TestHost.LuiFixtures;
style InputFixtureShell {
    Width: 320;
    Height: 490;
    Spacing: 12;
}

style InputFixtureScroll {
    Width: 280;
    Height: 80;
}

style InputFixtureContent {
    Width: 280;
    Height: 240;
    MainShrink: 0;
}

internal component InputFixtureView(InputFixtureModel model) {
    <CommandScope bindings={model.Bindings}>
        <Column name="input.container" style={InputFixtureShell}>
            <Status content={() => model.Status.Value} />
            <ScrollViewport label="Wheel target" viewport={model.Viewport} style={InputFixtureScroll}>
                <Column style={InputFixtureContent}>
                    <Text>Wheel content</Text>
                </Column>
            </ScrollViewport>
            <TextArea session={model.Editor} label="Multiline note" style={Style.Empty.Width(280).Height(180)} />
            <TextField session={model.SingleLineEditor} label="Single-line note" style={Style.Empty.Width(280)} />
        </Column>
    </CommandScope>
}
