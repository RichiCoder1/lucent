<Project Sdk="Microsoft.NET.Sdk;Lucent.Lui.Sdk/__LUCENT_VERSION__">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TemplateNamespace</RootNamespace>
    <AssemblyName>TemplateNamespace</AssemblyName>
    <Version>0.1.0-dev.1</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lucent.Core" Version="[__LUCENT_VERSION__]" />
    <LucentAsset Include="Artwork/mark.svg" Path="mark.svg" />
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
