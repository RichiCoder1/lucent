<Project Sdk="MSTest.Sdk/__MSTEST_SDK_VERSION__;Lucent.Lui.Sdk/__LUCENT_VERSION__">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TemplateNamespace</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lucent.Testing" Version="[__LUCENT_VERSION__]" />
    <!--#if (Skia) -->
    <PackageReference Include="Lucent.Testing.Skia" Version="[__LUCENT_VERSION__]" />
    <!--#endif -->
  </ItemGroup>
</Project>
