{
  "name": "lucent-lui",
  "displayName": "Lucent .lui",
  "version": "0.3.6",
  "publisher": "lucent",
  "lucentRelease": {
    "schemaVersion": 1,
    "language": { "id": "lui", "version": "preview", "featureLevel": "preview-1" },
    "protocol": { "id": "lucent-lui", "minimum": { "major": 1, "minor": 0 }, "maximumInclusive": { "major": 1, "minor": 0 } },
    "serverDelivery": "bundled"
  },
  "description": "Language support and cross-language tooling for Lucent .lui files.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RichiCoder1/lucent.git",
    "directory": "extensions/lucent-lui-vscode"
  },
  "bugs": { "url": "https://github.com/RichiCoder1/lucent/issues" },
  "homepage": "https://github.com/RichiCoder1/lucent/tree/main/extensions/lucent-lui-vscode",
  "categories": ["Programming Languages"],
  "keywords": ["lucent", "lui", "language server", "syntax highlighting"],
  "engines": { "vscode": "^1.95.0" },
  "main": "./extension.js",
  "extensionKind": ["workspace"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Syntax highlighting remains available; project evaluation and the language server require a trusted workspace.",
      "restrictedConfigurations": ["lucentLui.serverPath", "lucentLui.projectPath"]
    },
    "virtualWorkspaces": false
  },
  "files": [
    "extension.js",
    "server-bundle.js",
    "project-requirements.js",
    "server-cache.js",
    "server-acquisition.js",
    "managed-tool.js",
    "doctor-client.js",
    "onboarding-ui.js",
    "environment-ui.js",
    "release-catalog.json",
    "tooling-cache/**",
    "doctor/**",
    "onboarding/**",
    "server/**",
    "language-configuration.json",
    "syntaxes/**",
    "README.md",
    "LICENSE"
  ],
  "activationEvents": ["onLanguage:lui", "workspaceContains:**/*.lui"],
  "contributes": {
    "languages": [{
      "id": "lui",
      "aliases": ["Lucent LUI", "lui"],
      "extensions": [".lui"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "lui",
      "scopeName": "source.lui",
      "path": "./syntaxes/lui.tmLanguage.json"
    }],
    "commands": [{
      "command": "lucentLui.rename",
      "title": "Lucent: Rename Cross-Language Symbol"
    }, {
      "command": "lucentLui.restartLanguageServices",
      "title": "Lucent: Restart Language Services"
    }, {
      "command": "lucentLui.importServerArchive",
      "title": "Lucent: Import Server Archive"
    }, {
      "command": "lucentLui.installMatchingServer",
      "title": "Lucent: Install Matching Language Tools"
    }, {
      "command": "lucentLui.checkEnvironment",
      "title": "Lucent: Check Environment"
    }, {
      "command": "lucentLui.checkTrustedProject",
      "title": "Lucent: Check Trusted Project (MSBuild Evaluation)"
    }, {
      "command": "lucentLui.copyEnvironmentReport",
      "title": "Lucent: Review and Copy Environment Report"
    }, {
      "command": "lucentLui.selectProject",
      "title": "Lucent: Select Project"
    }, {
      "command": "lucentLui.showToolingStatus",
      "title": "Lucent: Show Tooling Status"
    }, {
      "command": "lucentLui.openGettingStarted",
      "title": "Lucent: Open Getting Started"
    }],
    "walkthroughs": [{
      "id": "gettingStarted",
      "title": "Get started with Lucent",
      "description": "Check your workspace host, choose a project, and start authoring .lui components.",
      "steps": [{
        "id": "environment",
        "title": "Check the environment",
        "description": "Inspect installed tooling and configuration without restoring or running your project.\n[Check environment](command:lucentLui.checkEnvironment)",
        "media": { "markdown": "onboarding/environment.md" },
        "completionEvents": ["onCommand:lucentLui.checkEnvironment"]
      }, {
        "id": "project",
        "title": "Choose your project",
        "description": "Open a Lucent workspace, review Workspace Trust, and select the project for language services.\n[Select project](command:lucentLui.selectProject)",
        "media": { "markdown": "onboarding/setup.md" },
        "completionEvents": ["onCommand:lucentLui.selectProject"]
      }, {
        "id": "tools",
        "title": "Check language tools",
        "description": "Open a .lui file. The Lucent status item explains which tools are active and offers applicable setup actions.\n[Show tooling status](command:lucentLui.showToolingStatus)",
        "media": { "markdown": "onboarding/setup.md" },
        "completionEvents": ["onCommand:lucentLui.showToolingStatus"]
      }]
    }],
    "configuration": {
      "title": "Lucent .lui",
      "properties": {
        "lucentLui.serverPath": {
          "type": "string",
          "default": "",
          "description": "Advanced override: path to a trusted Lucent.Lui.LanguageServer.dll on the workspace host. The server identity is checked before project evaluation."
        },
        "lucentLui.projectPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Evaluated .csproj, absolute or relative to the selected workspace folder."
        }
      }
    }
  }
}
